  } ],
  "events": [ {
    "tStartMs": 0,
    "id": 1,
    "wpWinPosId": 2,
    "wsWinStyleId": 1
  }, {
    "tStartMs": 320,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यो व्हाट्स अप गाइज़ कैसे हो आप सभी लोग\nवेलकम बैक टू अनदर वीडियो तो आज हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5120,
    "dDurationMs": 8559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दोबारा से खेलने जा रहे हैं GTA6 तो आज\nमैं बहुत ज्यादा एक्साइटेड हूं क्योंकि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 10480,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जसन की जो गर्लफ्रेंड है ल्यूसिया वो\nफाइनली प्रज़न से वापस आ रही है। देखो यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 17520,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लास्ट एपिसोड में उसका कॉल आया था और उसने\nहमें बोला था कि कुछ ही दिन में उसे रिलीज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 21520,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कर देंगे जेल से। तो भाई मैं तो बस कॉल का\nवेट कर रहा हूं लसिया के कि कब उसका कॉल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 26480,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आता है और कब मुझे उसे प्रजन से लेने के\nलिए जाना है। फिलहाल अभी तुम सोच रहे हो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 31039,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कि भाई जसन ये नंगा सड़क पे क्यों खड़ा हो\nरखा है? क्या कर रहा है? तो देखो यार बात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 35280,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ऐसी है कि जैसे रियल वर्ल्ड में हमें अपनी\nहेल्थ का ध्यान रखना होता है। हम लोग एप्स",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 39440,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पे जाके ट्रैक करते हैं ना। सेम यहां पर\nभी ऐसा है। यह मेरा फोन है। और ये सारी की",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सारी एक्सरसाइजज़ हैं। ये सारा का सारा\nवर्कआउट है जो मुझे करना होता है। फिलहाल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 48559,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कार्डियो में कर रहा था। तो इसीलिए मैं\nभाई बढ़िया रोड पे अपना रनिंग करने आ गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 52800,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "था। तो लेट्स गो भाई बिना किसी ओ भाई भाई\nआराम से आराम से सॉरी मेरी गलती है। रेड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 58079,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लाइट होने का वेट करने देना चाहिए था। बट\nठीक है। तो हां भाई मैंने सोचा क्यों ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 62320,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थोड़ा बहुत कार्डियो कर लिया जाए। एटलीस्ट\nएक गोल तो कंप्लीट हो। वरना इतनी जो सुंदर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 66640,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बॉडी जसन ने बना रखी है। यह सारी की सारी\nखराब हो जाएगी। और मुझे बस किसी तरीके से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 72240,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार वर्कआउट करते रहना है टाइम टू टाइम।\nबट एक इंपॉर्टेंट चीज देखो यार ल्यूसिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 78159,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है उससे पहले मुझे ना एकद इंपॉर्टेंट काम\nनिपटाने हैं। अभी तक हमने जितने भी मिशनंस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 83119,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करे थे ना वो सारे के सारे मिशनंस थे तो\nकाफी क्रेजी। हमने पहले मिशन में अपने एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 88240,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दोस्त को खतरनाक गैंग से बचाया। दूसरे\nमिशन के अंदर हमने गाड़ी चोरी करी। फिर एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 93360,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिशन में हमने एक बंदा ही टपका दिया अपने\nबॉस के लिए। बट आज आज जिस मिशन पे मैं जा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 99360,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा हूं वो मिशन काफी ज्यादा डिफरेंट है।\nतो हमारा जो बॉस है ना ब्रांड उसने हमें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 104240,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक बंदे से कनेक्ट करवाया था जिसका नाम है\nकटन और वो एक ट्रेजर हंटर है। मतलब भाई वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 109520,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चोरीचक्कारी नहीं करता। वो ट्रेजर हंट\nकरता है। तो उसने हमें बुलाया अपने साथ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 114479,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "काम करने के लिए। तो बिना किसी देरी के\nअपनी गाड़ी में बैठते हैं और जल्दी से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 118640,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सीधा चलते हैं कैंटन केनी के पास। उसका\nनिक नेम के नहीं है। बाय द वे आप लोगों ने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 123759,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखा होगा लास्ट एपिसोड में मैंने अपनी\nगाड़ी के अंदर कुछ अपग्रेड्स करवाए थे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 127759,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जैसे कि पीछे वाला जो एग्जॉस्ट सिस्टम है\nना ये मैंने चेंज करवाया था और तुम एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 131520,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बारी साउंड सुनो।\nये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 135440,
    "dDurationMs": 12879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड भाई पॉप्स नहीं आ रहे यार। आए आए\nआए पॉप्स आए। वो लेट्स गो। देख रहे हो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई। डोनट देखो तुम। गाड़ी बहुत ही ज्यादा\nक्रेजी कर रखी है मैंने। ओ वेट वेट वेट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 151200,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वेट वेट एक सेकंड\nभाई यार गाड़ी फ्लेक्स करने के चक्कर में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 156080,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्रॉब्लम हो गई यार।\nक्यों करता हूं मैं? मैं पता मेरे क्या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 163040,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बोलूं यार? गाड़ी के एग्जॉस्ट से ना फ्लेम\nनिकलता है। मैं वो दिखाना चाह रहा था। और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 167120,
    "dDurationMs": 8479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई इतनी ज्यादा देर तक मैंने बर्न आउट\nकरा कि व्हील भाई फूट गए हैं। जल के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 173360,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डिस्ट्रॉय हो गए। और अभी मुझे यह गाड़ी\nभाई जल्दी से जल्दी वर्कशॉप ले जानी है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 177519,
    "dDurationMs": 8201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार।\nकितनी दूर है वर्कशॉप भी यहां से बहुत",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 181599,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ज्यादा दूर है यार। नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 186022,
    "dDurationMs": 6378,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[गला साफ़ करने की आवाज़]"
    }, {
      "utf8": "\nयार मैं सोच रहा हूं टो करने के लिए बुला",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 188720,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लूं क्या? ए यार देखो अभी जो भी है जाना\nतो पड़ेगा। थोड़ी गाड़ी ना धीरे-धीरे ले",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 194319,
    "dDurationMs": 7601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाऊंगा। वरना और डैमेज हो गया तो मुझे\nपूरा का पूरा जो अलॉय है वो चेंज करवाना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 200400,
    "dDurationMs": 5199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पड़ जाए। तो मैं नहीं चाहता भाई इतना\nज्यादा खर्चा मैं क्यों करूं क्योंकि इस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 203840,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गेम में भाई पैसों की बहुत ज्यादा तंगी\nहै। जसन अभी बिल्कुल भी अमीर नहीं है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 207519,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उसने कोई बड़ी चोरी नहीं करी। उसके पास\nभाई थोड़ा बहुत पैसा है। बेचारे हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 212000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इतनी मेहनत से 400 $500 कमाते हैं और उसके\nबाद मैं गाड़ी पे फिर अपग्रेड्स करवा देता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 217040,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। हमने एग्जॉस्ट लगवाया था उसमें खर्चा\nहो गया। गाड़ी में छोटी-मोटी मॉडिफिकेशन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 222000,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में भी बहुत ज्यादा खर्चा हो जाता है।\nपुलिस है भाई पीछे बहुत तगड़ी। एक सेकंड।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 228239,
    "dDurationMs": 8161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो हां यार या तो भैया गाड़ी का शौक साइड\nरखो या फिर पैसे ज्यादा कमाओ। दोनों चीजें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 233840,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक साथ नहीं हो सकती है। फिलहाल ये गाड़ी\nना इस टाइम पर बहुत स्लिप कर रही है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 239040,
    "dDurationMs": 6559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्योंकि ऑब्वियसली यार पीछे वाले व्हील्स\nनहीं है तो ग्रिप नहीं बनेगी ना। बट ठीक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 243360,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है थोड़ी सी भगाते हैं। टाइम पे बस\nब्रेकिंग हो जाए वरना मैं बुरी तरह",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 247680,
    "dDurationMs": 9519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठुकूंगा और गाड़ी आगे से भी डैमेज हो सकती\nहै। और लेट्स गो गाइस। शॉप आ चुकी है। भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 253280,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक बारी जाने दो यार। एक बस बस बस बहुत ओए\nरुक जा यार रुक जा रुक जा भाई गाड़ी टूटी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 259440,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हुई है समझ नहीं आ रहा क्या\nभाई इस बंदे के मजे आ रखे हैं यार मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 264800,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बार-बार गाड़ी तोड़ देता हूं कुछ ना कुछ कर\nदेता हूं और इसकी दुकान पे मेरा चक्कर लग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 269280,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ही जाता है कर भाई $0 देने पड़ गए बेमतलब\nयार क्या बोलूं मैं ठीक है व्हील्स इसने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एकदम सही तरीके से लगा दिए हैं बाकी यार\nमैं अब आया ही हूं तो एक आध अपग्रेड और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 280560,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करवा दे क्या देखो अपनी अभी जो ग्रिल है\nना ऐसी दिखती है जो कि बहुत गंदी है तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 284639,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पहले तो इसे ना थोड़ा सा डार्क करवाते हैं।\nयह कितने की करवा दी मैंने? भाई कर दिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 289040,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने खर्चा लग रहा है दोबारा तगड़ा। यार\nदेखो यह लिवरीज़ वगैरह मैं करवा सकता हूं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 292400,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बट $750 की है और मेरे पास इतना पैसा नहीं\nहै। देखो यार एक चीज़ ना मैं और ऐड करवा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 297199,
    "dDurationMs": 6241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा हूं। यह होते हैं हुड कैचेस जो कि भाई\nमस्त दिख रहे हैं ना अपनी गाड़ी के ऊपर। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 301280,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यह हुड खोलने का लॉक सिस्टम होता है। तो\nइसको खरीद लेते हैं। सस्ता ही है यार ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 305040,
    "dDurationMs": 5599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वाला अपग्रेड। बस मैं एक साथ सारा अपग्रेड\nनहीं करवाएंगे। धीरे-धीरे अपनी गाड़ी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 308400,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अपग्रेड करेंगे। लेट्स गो गाइस। तो गाड़ी\nरिपेयर होने के साथ-साथ थोड़ी सी हमने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 312479,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी की लुक भी चेंज करवा ली और बाहर का\nवेदर इतना खतरनाक हो चुका है क्योंकि ऊपर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 317199,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बादल देख रहे हो भाई ऐसा लग रहा है बहुत\nजोरों शोरों से बारिश होने वाली है या फिर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 322320,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये नकली वाले बादल है भाई अपना बिना बारिश\nके चले जाएंगे बाकी ठीक है यार जैसा कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 326639,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने तुम्हें बोला था आज हमें जाना है\nअपने दोस्त केनी के पास तो लेट्स गो मार्क",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 330960,
    "dDurationMs": 6959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने लगा लिया है जिस जगह पे मुझे बुला\nरहा है ओ भाई बहुत अच्छा ड्राइवर है तू",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 335440,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बचा लिया तभी गाड़ी टूट जाती तो गाड़ी को\nफुल स्पीड में भगाते हैं और जल्दी से चलते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 340000,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं कैरी के पास क्योंकि मैं बहुत\nएक्साइटेड हूं भाई ट्रेजर हिंट करने के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 343440,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए। मुझे नहीं आईडिया भाई कितना पैसा\nमिलने वाला है। बट मैं चाहता हूं कि लसिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 347919,
    "dDurationMs": 7441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आए। उससे पहले यार थोड़े बहुत हम लोग अमीर\nदिखे। हमारे पास अच्छी साफ सुथरी गाड़ी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 352720,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो। बढ़िया घर हो। हालांकि घर बढ़िया नहीं\nथा। हमने उसे रिपेयर करके बढ़िया कर दिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 357600,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। लेकिन गाड़ी गाड़ी में देखो कोई कमी\nनहीं है यार। जितनी भी चीजें पुरानी थी,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 362880,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "घटिया दिख रही थी, सारी की सारी मैंने\nएकदम मस्त करवा दी है। और सबसे मस्त चीज़",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 368000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पैसा भी अपने पास इकट्ठा होता जा रहा है।\nअगर आज ये ट्रेशर हंट वाला मिशन मस्त जाता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 373600,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है, तो हम लोग आई थिंक यहां से काफी अच्छा\nखासा पैसा कमा सकते हैं। ओ वेट वेट वेट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 378000,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वेट। यहां से मुझे अपनी गाड़ी को अंदर लेके\nजाना है। और आई थिंक मैंने गलत गली में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 382000,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टर्न ले लिया। तो खाली पीली मैंने गलत\nटर्न ले लिया था। यानी मैं पहले ही सही जा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 385280,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा था। मैंने देखा राइट लेना है। फिर पता\nनहीं कहां से गाड़ी घुमा ली। बट ऑलराइट यह",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 389520,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वाला सही रास्ता है। मुझे उसने जितना मुझे\nसमझ आ रहा है किसी बीच साइड पे बुलाया है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 10720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जहां पर पता नहीं ये क्या प्लानिंग है। हम\nलोग पानी में जाने वाले हैं क्या क्योंकि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 400880,
    "dDurationMs": 10800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इस जगह पर आने का मतलब ओ वेट\nभाई सामने मुझे एक बोट पार्क्ड दिख रही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 408800,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है।\nभाई क्या मस्त जगह है यार ये। हमने अपनी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 415039,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी यार यहां पर लगा तो दी है बट गाड़ी\nसेफ तो रहेगी ना यार। पता चला इधर कोई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 420240,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठोकठाक के चला गया क्योंकि मैंने बीच में\nगाड़ी खड़ी कर दिया बट कोई दिक्कत नहीं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 423440,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कैनी का अड्डा है भाई तो अपने को दिक्कत\nनहीं आनी चाहिए। लेट्स गो। चल के मिलते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 427599,
    "dDurationMs": 3801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं कैनी भाई से।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 431599,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ऑलराइट गाइस तो अभी हम आ चुके हैं केनी से\nमिलने के लिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 443599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 449120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चेंज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 456160,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मजा आने वाला है इस में।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 461280,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो बेसिकली यहां पे जब हरिकन आता है ना तो\nओशन के अंदर का सारा सामान मूव करता है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 465759,
    "dDurationMs": 4801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सब इधर उधर हो जाता है। यानी कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 470720,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जितना भी खजाना पानी के अंदर है बहुत\nचांसेस है कि वो इस तरफ आ गया होली",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 482800,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये लोग कौन है भाईडी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 497599,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गना बी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 501039,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो बेसिकली\nये तीनों के तीनों टूरिस्ट जिनको हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 505759,
    "dDurationMs": 8001,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेकर जा रहे हैं अपने साथ स्कूबा\nड्राइविंग करने के लिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 511919,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्कूबा ड्राइविंग करते हुए हमारा प्लान है\nट्रेजर एंड करना।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 517279,
    "dDurationMs": 8481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो गाइस। बोट में हम लोग आकर बैठ\nचुके हैं। और अभी हमें एक ऐसे पॉइंट पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 522719,
    "dDurationMs": 9481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाना पड़ेगा जहां पे पानी थोड़ा सा क्लीन\nहो, डीप हो। ड्राइविंग करी जा सके और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 528640,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "खजाना भी मिले।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 532240,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो यार अभी कैनी जो है उन सबको थोड़ा सा\nट्यूटोरियल दे रहा है कि कैसे-कैसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 538000,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या-क्या करना है। हम लोग अपने को ऐसे\nदिखा रहे हैं कि भाई हम लोग एक कंपनी है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 542160,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जो टूरिस्ट को स्कूबा ड्राइविंग करवाती\nहै। लेकिन स्कूबा ड्राइविंग करवाते हुए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 547200,
    "dDurationMs": 11840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमारा प्लान कुछ और ही है। तो बेसिकली काम\nडायरेक्टली नहीं हो रहा बट हो रहा है। और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 554560,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई साहब इतनी सारी बोट पानी में है। मतलब\nएक्चुअल में कितना बढ़िया लग रहा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 563920,
    "dDurationMs": 10120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई फोटो खींचेंगे।\nफ़ नहीं चलाता यार ये गाड़ी चलाते हुए।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 571040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 576480,
    "dDurationMs": 7039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है। तो ये कह रहा है कि भाई तुम एज अ\nगाइड इनको लेकर तो जा रहे हो। बट एक बार",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 580880,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जब नीचे ले जाओगे ना तो वो लोग जाए भाड़\nमें। हमें अपना काम करना है। हमें ट्रेजर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 586560,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ढूंढना है।\nभाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 589920,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसने थोड़ी ना रिसर्च वगैरह कर रखी है कि\nपानी के अंदर कहां का खजाना कब और कैसे आ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 595680,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सकता है। तो जैसे थोड़े टाइम पहले यहां\nहरिकन आया होगा [हंसी] तो बहुत सारा पानी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 599680,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मूव करा होगा। खजाना इधर-उधर मूव हुआ\nहोगा। तो उसको ऐसा लगता है इस तरफ आया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 604240,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "होगा। बाकी चल के देखते हैं। यार ये तो एक\nबहुत बड़ा गेस है। लेकिन यार क्या मस्त",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 608880,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिख रहा है ना सब कुछ। वो सामने जो सिटी\nहै ना मुझे बस समझ नहीं आ रहा वो वाइट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 613600,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सिटी है या दूसरी सिटी है। वैसे इतनी सारी\nबिल्डिंग्स तो वहीं हो सकती है लेकिन यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 618640,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये जगह बहुत बड़ी है। मुझे ऐसा लगता है व\nसिटी इतनी पास नहीं होगा। वो और ज्यादा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 623360,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दूर होगा। बाकी ठीक है देखेंगे। लेट्स गो\nगाइस। तो अभी हम लोग पहुंच चुके हैं उस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 628800,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जगह पे जहां पे हम लोग स्कूबा ड्राइविंग\nकरने वाले हैं। आइलैंड ड्रीम्स कैनी की",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 633680,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कंपनी का नाम है भाई।\nओ भाई मैं इनका गाइड हूं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 640640,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनको मुझे स्कूबा ड्राइविंग करवानी है।\nजसन को आती तो होगी ना खुद वैसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 654079,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कमिक मेमोरी\nलेट्स गो बॉयज कूदने दो इन्हें इन्हें पता",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 658959,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कि हम लोग इन्हें डविंग करवाने नहीं लेकर\nआए हमारे अलग ही प्ल्स है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 665519,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कुदा दिए भाई तीन बंदे और भाई कूद तो गए\nहैं पर अब अपनी बारी है। तो लेट्स गो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 671839,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाइस। चले\nये क्या है?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 683827,
    "dDurationMs": 6252,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[गला साफ़ करने की आवाज़]"
    }, {
      "utf8": "\nसमझाली।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 687519,
    "dDurationMs": 9601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो गाइस इसने ना हमें दो टूल दिए हैं।\nएक आई थिंक मेटल डिटक्टर है जिससे हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 692399,
    "dDurationMs": 9601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पता कर पाएंगे और एक है कोई तो गन दी है\nकि कल को नीचे खतरा होगा तो हेल्प आएगी।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 699760,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो गाइस। तो अभी ना मैंने इनको यह\nबोल दिया है कि तुम तीनों जाओ। मैं तुम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 704399,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तीनों के पीछे आ रहा हूं। तो इससे अपने को\nफायदा यह होगा कि हम लोग चुपचाप से जिस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 708880,
    "dDurationMs": 6399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "काम के लिए यहां पर आए हैं वो काम कर\nपाएंगे और इनको कुछ पता भी नहीं चलेगा। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 712959,
    "dDurationMs": 5521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थोड़ा सा ना पानी के अंदर चलते हैं और\nथोड़ा तेज स्विम भी कर सकते हैं हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 716800,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इससे। लेट्स गो। लेट्स गो। लेट्स गो।\nलेट्स गो। लेट्स गो। यहां पर ना कुछ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 719920,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अलग-अलग पॉइंट्स हैं जहां पर हमें शायद से\nट्रेजर मिल सकता है। बट पता नहीं वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 726880,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पॉइंट्स कैसे ढूंढूंगा मैं। मेरे को तो\nदेखो यहां पर समझ नहीं आ रहा है। थोड़ा सा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 730800,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना आई थिंक आगे जाना चाहिए हमें। यहां पर\nकुछ नहीं होगा। तो थोड़ा आगे चलते हैं। और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 736720,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये लोग तो भाई मजे कर रहे हैं यार। पानी\nमें अकेले ही घूम रहे हैं। डर ही नहीं लग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 740880,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा भाई ये। मतलब मैं एक्चुअली में बता\nरहा हूं भाई स्कूबा ड्राइविंग फर्स्ट टाइम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 744639,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करो ना जब तो थोड़ा सा डर तो लगता है। तुम\nकितने भी बहादुर हो भाई एक डर रहता है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 750320,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने दो बार करी है मुझे पता है लेकिन\nनॉर्मल हो जाता है फिर थोड़े टाइम बाद",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 754160,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बहुत अच्छा लगता है। जैसा दिख रहा है ना\nये इतना ही ब्यूटीफुल होता सब कुछ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 758959,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कहां पर मिलेगा ट्रेजर वो मैं सोच रहा हूं\nयार अगर मैं नहीं ढूंढ पाया तो भाई केनी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 763760,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो भरोसा उठ जाएगा यार उसका मेरे पे से कि\nक्या बेकार बंदा है ये ओके नीचे चलते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 770399,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई क्या नजारे हैं यार मतलब कितना क्रेजी\nलग रहा है सब कुछ और यार वैसे ना मुझे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 776160,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनके आगे-आगे नहीं इनके पीछेछे रहना चाहिए\nथा लेकिन मैं बहुत ज्यादा आगे आ चुका हूं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 781680,
    "dDurationMs": 10760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ वेट\nयहां कुछ है यहां पे गाइस एक बोट है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 788160,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसी जगह की बात वो कर रहा था",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 794240,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पता नहीं यार इस इस चीज की तो बात उसने\nकरी थी नहीं करी थी बट मुझे ऐसा लगता है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 799200,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जो चीज ढूंढने हम लोग यहां पर आए हैं वो\nयहां होनी चाहिए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 805519,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उनको मैंने ऐसे बोला कि भाई तुम शिपरेक की\nतरफ जाओ शिपरेक को देखो अच्छे से मैं यहां",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 810880,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पर अपना काम करता हूं तो मैंने अपना मेटल\nडिटक्टर निकाल लिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 815040,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और अभी मुझे इसे स्कैन करना है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 821360,
    "dDurationMs": 9919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ ये रहा ये रहा। ओ ये इधर कुछ है।\nकैसे लूंगा मैं?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 827680,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके तो मैंने अपना मेटल डिटक्टर अंदर रखा\nहै।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 833040,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई देखो मुझे पता नहीं वो डिवाइस कौन सा\nहै। बट आई थिंक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 843440,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दोबारा से एक बीप आना चालू हुई है।\nऔर यहां पर भी मुझे एक मिला। आई थिंक इधर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 848160,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना बहुत ज्यादा है। बस ये है कि किसी को\nभी लूटना अलाउड नहीं है। तो यहां से मुझे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 854800,
    "dDurationMs": 10039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिट्टी हटानी पड़ेगी और मिट्टी हटाते ही\nहमें एक और पता नहीं कॉइन है। गोल्ड कॉइंस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 861519,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है यार ये।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 868320,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई एक सेकंड।\nवो लोग वेट कर रहे हैं। कह रहे हमारा गाइड",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 872320,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कहां पर है?\nउन्हें कुछ दिख नहीं रहा भाई। कोई बंदा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 875680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उनको",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 879040,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या क्या\nरुको आ रहा हूं।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 883279,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या हो गया भाई? क्या कर रहे हो? ओ भाई\nये शिप रेक एक्सप्लोर करने आए थे और इस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 888560,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बंदे को देखो। फस चुका है ये इसके अंदर।\nऔर ये दोनों खड़े हो के देख रहे हैं। भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 894000,
    "dDurationMs": 10480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हटाओ हेल्प को। उसके पैरवैर दब गए यार।\nरुको [हंसी] भाई ये ले ये ले। चल ले भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 901360,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाहर निकल शुक्र है भाई यह जिंदा सेफ है।\nओ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 909920,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बेचारे घबरा गए थे थोड़ा लेकिन अभी क्या\nहुआ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 915120,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई उसके ना लोहे से पैर दब गया था और\nशायद उसके कटवट लग गया और उसके खून आ रहा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 919040,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है पैर से कोई दिक्कत वाली बात नहीं है\nजल्दी से लेकर इसे ऊपर चलते हैं और फटाफट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 924079,
    "dDurationMs": 6241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यहां से निकलेंगे भाई लेट्स गो लेट्स गो\nलेट्स गो चल चल भाई तू बाहर चल एक मिनट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 928720,
    "dDurationMs": 9359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाइस\nऊपर से मुझे शार्क आती हुई दिख रही है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 934399,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई शार्क कहां से आ गई?\nओए रुको मेरे पास एक गन है। बट रुको रुको",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 941760,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो हमें कुछ कह नहीं रही है। अब कुछ कह\nनहीं रही है। कुछ कह नहीं रही है। कुछ कह",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 944560,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं रही है। चुपचाप जाने दो भाई इससे\nज्यादा बेटर है। पंगे लूंगा तो दिक्कत हो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 948959,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाएगी। लेकिन नहीं\nशार्क ने हमें अच्छे से देख लिया है। पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 954240,
    "dDurationMs": 11480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो इधर को आ। ओए नहीं नहीं नहीं। अरे छोड़\nमैंने उसे गोली भी मारी। अरे नहीं यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 960560,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मेरे जल्दी मारना चाहिए। ओ भाई गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 966639,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई शक\nसॉरी यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 971839,
    "dDurationMs": 7201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमारे एक बंदे को उठा के लेकिन मेरे उसे\nगन यार पहले ही मार देनी चाहिए थी मुझे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 977120,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लगा वो चुपचाप जा रही है पंगे नहीं लेने\nचाहिए और ये क्या एक और शार्क है क्या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 981120,
    "dDurationMs": 10639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं अलग मछली है भाई ये क्या हो गया यार\nवो बेचारे को भाई कैनी तो मुझे छोड़ेगा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 989680,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं आज उसे पता चलेगा कि मेरी वजह से कुछ\nऐसा हुआ है। देखो यार मुझे समझ नहीं आ रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 993759,
    "dDurationMs": 8601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी क्या करना चाहिए। जो भी है केनी को सब\nबता देंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1004240,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके ग\nयार ये तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1015759,
    "dDurationMs": 6281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मुझे लग रहा था कि कैनी मुझे डांटने वाला\nहै और ये कौन है?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1027199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लास्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1032160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबाउट्स",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1038720,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो बेसिकली\nये लोग भी ट्रेजर हंटिंग पे निकले हुए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1043760,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। और कटन अपने आपको इसलिए ऐसा दिखाता\nहै कि वो एक स्कूबा ड्राइविंग वाला टूर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1051120,
    "dDurationMs": 10280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देता है ताकि सब लोग को पता ना चले वो\nयहां क्या कर रहा है। क्योंकि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1057440,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो। हमें ये सब मिला था।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1064480,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई\nये स्पैनिश है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1075200,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो हमने आई थिंक ना बहुत ज्यादा क्रेजी\nचीज ढूंढ निकाली है। और जैसा कि मैंने",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1079760,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तुम्हें बताया भाई वो जो बाकी लोग आए थे\nना दूसरी बोट पे वो एक टाइप से हमारे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1084160,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "राइवल्स हैं। अगर उन लोग को पता चल जाएगा\nशिप रैक कहां पे सारा खजाना वो लूट लेंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1090559,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाकी यार ये गलत हो गया थोड़ा\nयू",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1095919,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई डू\nयार देखो जो भी हुआ गलत हुआ। बट हां",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1099760,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्रेजी चीज ये है। मुझे लग रहा था भाई\nकैनी मुझे डांटेगा। मुझे बोलेगा क्या यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1103760,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तू एक बंदे का ध्यान नहीं रख पाया। बट\nकैनी ने कहा भाड़ में जाए ना यार पैसा तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1108000,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आया है ना\nउसे दुख ही नहीं है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1123200,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बेचों की बैचलर खराब कर दी हमने",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1129919,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई थिंकनी पे मैं डाउट कर रहा था कि यार\nपता नहीं थोड़ा अजीब बंदा होगा बट ये बंदा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1134160,
    "dDurationMs": 11200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बढ़िया निकला यार और लेकिन पर्सनली जसन को\nबहुत ज्यादा दुख है यार वो खुश नहीं है कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1142400,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उसकी वजह से इन तीनों दोस्तों में से एक\nदोस्त मारा गया। यही चीज मुझे अच्छी लगती",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1147919,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है यार कि जसन का नेचर बहुत ज्यादा स्वीट\nहै। बट हां यार जो भी है अभी क्या ही कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1154240,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सकते हैं यार। मतलब जो हो गया हो गया। अभी\nइस बिनेस में आगे बढ़ना है। तो इन सब",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1159200,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चीजों को ना सोचना बंद करना पड़ेगा। और\nजिस हिसाब से कैनी बोल रहा है हमें चलना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1164559,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पड़ेगा। लेकिन मैं सही बताऊं मुझे ऐसा\nलगता है आज भी कि कैनी हमें धोखा देगा एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1169120,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिन। बाकी ठीक है। देखते हैं अगर ज्यादा\nपैसा कमाएंगे तो कैनी से ही कमा पाएंगे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1174160,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जल्दी में तो। वरना एक सेकंड यार राइट में\nएक शॉप है जूस का। तो फटाफट से चल के यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1180080,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक जूस पीते हैं। और मैं मैं तब से मैं\nनोटिस नहीं कर रहा। मैं रनिंग करने के लिए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1185679,
    "dDurationMs": 6961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "निकले। शर्टलेस घूम रहा था। और अभी मैं\nपूरे टाइम ही शर्टलेस घूम रहा हूं। हेलो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1191039,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या-क्या ऑप्शंस है भाई चेक करते हैं\nफटाफट से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1194960,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसको आर्डर देना है हमें एप्पल जूस है\nबेरी स्मूदी है ऑरेंज जूस है एक काम करते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1201039,
    "dDurationMs": 10561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं बेरी स्मूदी पीते हैं सबसे महंगी जो\nहै ओके तो बेरी स्मूदी दे दो एक अरे दोद",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1208480,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "खरीद ली मैंने गलती से\nलसिया होती तो दोनों पी लेते हम बट ठीक है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1214799,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी एक ही पीते हैं ऑल राइट गाइस तो वेरी\nस्मूदी हमने फिनिश कर दिया यार। दूसरी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1219760,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वाली फेंक देता हूं क्योंकि ये वाली फेंक\nदी और दूसरी वाली को लेके गाड़ी में बैठ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1224160,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाते हैं ना। गाड़ी में अपना धीरे-धीरे\nपीते रहेंगे। बाकी ठीक है। अभी ना यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1227919,
    "dDurationMs": 6481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मेरे को बड़ी देर से हमारा जो दोस्त है ना\nकैल वो मैसेज कर रहा है। कह रहा है भाई घर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1232240,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पे आ जाओ। प्लेस्टेशन पे गेम खेलते हैं।\nतो मैं एक बारी वेट कर रहा हूं। रुको अभी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1236640,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है वो घर पे कि नहीं है। यह देखो\nक्या-क्या मैसेज भेज रहा है यार। ये क्या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1240320,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गर्लफ्रेंड है क्या मेरी? हरी होम बे।\nइसको बोल देते हैं भाई देख घर पर तो है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1244559,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है। टॉयलेट मत जाम कर दियो हमारे।\nखाता बहुत है ना क्योंकि लेट्स गो गाइस।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1248720,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "घर का मैप हमने लगा लिया और अपना घर यहां\nसे ज्यादा दूर है ही नहीं यार। पास में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1252240,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। मैं अपने घर के पास ही था इतना ज्यादा\nक्या? लेट्स गो गाइस। फटाफट से चलते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1257440,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और आज हम लोग थोड़े गेमवेम भी खेलने वाले\nहैं। मतलब मैं ऑलरेडी गेम खेल रहा हूं बट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1262240,
    "dDurationMs": 8559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गेम के अंदर गेम खेलेंगे। बढ़िया भाई। डन।\nतो गाड़ी यहां पर पार्क कर दी है और मेरे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1268960,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पास अरे यह भी बचा हुआ है। यह पी लेते\nहैं। मैं ये कहना चाह रहा था यह अपना मेल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1272960,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बॉक्स है। तो जिनजिन के लिए हम काम करते\nहैं जो पैसा भिजवाना होता है ना जिसको वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1277120,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यहां पर भिजवा देता है। डन यार तो हमने\nस्मूदी पी के अपना स्टैमिना और फोकस दोनों",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1281760,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनक्रीस कर लिया है। इसको फेंक देते हैं।\nऔर इसमें से पैसा कल भाई कितना ज्यादा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1286640,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पैसा आया है। $2160\nऔर $200 कैल की तरफ से अभी आए हैं। बाकी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1292880,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "घर जैसा कि मैं बता रहा था बहुत ज्यादा\nअच्छी कंडीशन में तो नहीं है अपना बट हां",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1296880,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहने लायक बहुत मस्त हो चुका है अंदर से\nबहुत सही है जितनी चीजें खराब थी वो भी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1301440,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने सारी की सारी रिपेयर करवा ली है और\nएक और चीज जो कि मैंने तुम्हें अभी तक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1305280,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं दिखाई थी वो पता है क्या है मेरी\nबाइक जसन के पास ये जो बाइक है वो मैंने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1310559,
    "dDurationMs": 6321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी तक तुम्हें दिखा दी थी शायद बट चला के\nनहीं दिखाई थी मैंने खुद भी नहीं चलाई है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1314400,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्योंकि तो लेट्स गो अपनी बाइक लेकर\nनिकलते हैं और एक राउंड मार कर आते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1318960,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अपने नेबरहुड का ठीक है थोड़ा सा घूमेंगे\nऔर मेरे मेरे को पता स्टंट मारने का मन कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1323360,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा है। पता नहीं क्यों। तो लेट्स गो।\nलेट्स गो। लेट्स गो। हम मारेंगे एक विली।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1328080,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड। थ्री एक सेकंड। पहले बीच में\nखड़ी करते हैं। भाई गिरना नहीं है मुझे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1331760,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पूरे अपने बेेजती हो जाएगी। थ्री टू वन ले\nले।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1337200,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हुआ था। हुआ था। रुको।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1341520,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो तो रहा है। बट वापस से कंटीन्यूसली\nनहीं जा रहा।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1347280,
    "dDurationMs": 9519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ नाइस। बढ़िया तरीके से चल रहा है ये।\nडोनट मारेंगे भाई इससे भी स्टॉपी भी मार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1353840,
    "dDurationMs": 10800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सकता हूं मैं आई थिंक ये अगर जाके मैं\nब्रेक के साथ आगे जाऊं तो वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1361039,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई ओ क्या बाइक है यार इसकी वाली\nबढ़िया बाइक लेके जा रहा है बंदा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1367919,
    "dDurationMs": 11760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रुको एक बार और ट्राई करते हैं ये\nओ ये गई ना ये अच्छी आई थी एक दो तीन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1377600,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ नाइस मुझे ऐसा लग रहा है प्रैक्टिस करते\nरहेंगे ना तो इंप्रूव हो जाएगी बहुत",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1381440,
    "dDurationMs": 6239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ज्यादा।\nओ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1385120,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ए\nनाइस अब जा रही है। चलो गाइस एक और लास्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1390799,
    "dDurationMs": 3961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ट्राई थ्री टू वन।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1395200,
    "dDurationMs": 10320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई ये आई ना बढ़िया व्हीली। दोबारा से\nअब एक स्टॉपी मारेंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1401919,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये गई सीधी-सीधी और इसी के साथ ये एक\nस्टॉपी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1407280,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मस्त। बाइक चलाने के अलग मजे हैं। तो ठीक\nहै फटाफट से घर पे चलते हैं। जैसा कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1412159,
    "dDurationMs": 6321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने तुम्हें बताया था कैल हमारा दोस्त\nआया हुआ है। वेट कर रहा है गेम खेलने के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1415840,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए। उसको भाई कोई पार्टनर तो चाहिए तो\nफटाफट वेट वेट वेट वेट गलत जगह हो गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1420960,
    "dDurationMs": 11280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं। हमारा घर पीछे वाली गली में है। तो\nयहां से जाकर मुझे लेफ्ट जाना है। बढ़िया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1428799,
    "dDurationMs": 8561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई बाइक में अलग मजा आ रहा है यार। क्या\nक्विक है ना बाइक बहुत ज्यादा। कहीं से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1434480,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कहीं घुमा दो। तुरंत चले जाओ। हां बाकी\nठीक है। आज यार नहाने का मन कर रहा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1439200,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बहुत ज्यादा बाहर घूम-घूम के आए हैं।\nस्कूबा ड्राइविंग कर लिया। पता नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1442159,
    "dDurationMs": 6961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या-क्या करा है।\nजिम अपना मिस हो जाता है। जिम नहीं कर रहे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1446799,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं हम लोग। बट ठीक है। थोड़ा बहुत इग्नोर\nकर सकते हैं। जिस हिसाब से मेहनत चल रही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1450720,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। कार्डियो होते रहता है अपना। तो ठीक\nहै। घर पहुंच चुके हैं। और इसको देखो भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1460080,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कर क्या रहा है ये?\nओ तेरी करंट लग गया।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1465279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1473279,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये अभी काम कर रहा है स्टेशन ये हमारा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1491440,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई मैं तुम्हें क्या बोल रहा था ये और\nलेस्टर का मिक्सचर है। इसे ये हैकिंग भी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1497200,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थोड़ी बहुत जानता है और गेम खेलना भी पसंद\nहै।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1500400,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सीडी लेकर आया है [हंसी] भाई।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1509360,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है। ठीक है।\nकाफी डिफरेंट टाइप की गेम्स पसंद है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1515440,
    "dDurationMs": 9920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो चलो भाई\nभाई लगा देख जरा। घर से प्रॉपर अपना बंदा।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1522799,
    "dDurationMs": 6161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबे यार यह दोस्त है इसलिए इसकी सुन ले\nरहे हैं वरना यह पिटाई तो मांगता है। कह",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1527360,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा है भाई जाक पहले मेरे लिए ड्रिंक्स\nलेकर आ। बताओ भाई ऐसे ऑर्डर देता है कोई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1531760,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है यार इसके लिए निकाल लेते हैं।\nदोस्त आया घर पे थोड़ा बहुत। यहां हीरो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1535200,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बंदा है। वैसे बाहर तो बहुत ज्यादा फट्टू\nहै। ये वही बंदा है जिसने हमें मना करा था",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1538559,
    "dDurationMs": 7441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कि इसे इस सब टाइप के बिनेस में नहीं जाना\nजहां पर इतना ज्यादा खतरा होता है। लेकिन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1543200,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये धीरे-धीरे हमारे साथ एंटर कर चुका है।\nवेट हाउ लॉन्ग हैपन?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1549919,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जस्ट\nव्हाई?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1556480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रूफ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1559840,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या हुआ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1563520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बीस्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1580559,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसको भी हमने बताया की लसिया वापस आ रही\nहै तो ये कह रहा है भाई देखो फिर सामान इस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1584159,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तरीके से नहीं रखा होना चाहिए कोई दूसरे\nतरीके से रखा होना चाहिए बट मुझे समझ नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1588240,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आ रहा सही तो लग रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1597200,
    "dDurationMs": 8719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबाउट\nपागल है क्या ये सही तो लग रहा था वहां पे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1603279,
    "dDurationMs": 9561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या करना चाह रहा है\nकेक कहां ला के रख दिया भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1609840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "परफेक्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1618559,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई इसको कह रहा है लड़कियों का ज्यादा\nपता है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1622320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मेकर्मो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1626960,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये पिटेगा भाई [हंसी]\nमतलब अच्छा खासा घर अपना लग रहा था और ये",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1633760,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कह रहा है भाई लड़कियों को ऐसा सही नहीं\nलगता पता नहीं भाई मुझे तो कोई कमी ही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1637360,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं लग रही थी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1650080,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या सेटिंग खराब करा रहा है हमारे घर की\nयार ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1655520,
    "dDurationMs": 6279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी भी गड़बड़ है। देखो भाई थोड़ा सा इधर\nकरने को कह रहा है ये। सही है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1663120,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई इतनी चिंता तो हमें नहीं है लसिया की\nजितनी इसको है। ले भाई थोड़ा सा इधर कर",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1667679,
    "dDurationMs": 8441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देते हैं।\nअबे कुछ पता भी नहीं चल रहा यार। ये सही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1673120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1676819,
    "dDurationMs": 6181,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    }, {
      "utf8": "\nयार",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1679440,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डू इट इट राइट।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1683600,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मोर\nओके लॉट मोर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1686960,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबे",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1692640,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "परफेक्ट डोंट मूव इट डोंट टच इट ओके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1701760,
    "dDurationMs": 6840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पता नहीं भाई क्या आदमी है\nक्या कर दिया यार ये",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1708960,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "समझ नहीं आया मुझे इसने क्या करा है अच्छा\nखासा सेटअप खराब कर डाला",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1725200,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आईडिया\nफेसिंग डोर दे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1732960,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अरे भाई",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1737200,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये भी इसको कह रहा है कि थोड़ा सा चेंज\nकरते हैं।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1741520,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मुझे पहले पता होता ना यह ऐसे करना थोड़ा\nइसको साइड रखो पहले उसके बाद सोफा हटेगा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1749120,
    "dDurationMs": 6279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है किधर करना है दोनों को हुक करा ला\nले ले",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1756880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1761679,
    "dDurationMs": 5041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हां\nदेखो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1764559,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बहुत ज्यादा अच्छा नहीं है। पहले वाले से\nबेटर नहीं है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1768640,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बट थोड़ा सेंसिबल है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1787039,
    "dDurationMs": 8481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जसन ने बताया नहीं जैसा कि तुम्हें पता\nहोगा लसी और जसन का एक बच्चा भी है बट वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1793039,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनके पास नहीं है वो चाइल्ड केयर वालों के\nपास है क्योंकि ये दोनों जिस हिसाब से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1797520,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्राइम वगैरह करते रहते हैं बार-बार जेल\nमें आना जाना लगे रहता है। तो अथॉरिटीज ने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1803039,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गवर्नमेंट ने इनसे वो बच्चा छीन लिया है\nऔर ये इस टाइम पर इसको बताना नहीं चाहता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1808960,
    "dDurationMs": 10640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है कि सिचुएशन क्या है? तो क्या लाना है\nये? ये उठा के लाना है क्या?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1816399,
    "dDurationMs": 8561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके देखो यार मैं थोड़े से नखरे करता है।\nबोलता बहुत ज्यादा है। बट बंदा बढ़िया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1821679,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो। हमारा जॉय स्टेशन चालू हो चुका\nहै और अपडेट हो रहा है भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1828080,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आज हम लोग\nगेम में गेम खेलने जा रहे हैं यार। भाई यह",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1832559,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो पूरा ऐसा लग रहा है। मैं मैं\nप्लेस्टेशन के अंदर प्लेस्टेशन खेल रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1836640,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। वाओ\nगेम तो इसने चालू कर दी है। चालू हो रही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1841520,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है ना भाई?\nयू रेडी टू गो?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1844159,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हां हां आ रहा हूं। रुक जा। चल वेट कर रहा\nहै वो। हम बैठेंगे तो चालू करेगा।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1849279,
    "dDurationMs": 5681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आ रहा हूं। चल चल।\nदेखते हैं भाई पता नहीं कौन सी गेम लेकर",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1852799,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आया। बाहर से लाइट इतनी ज्यादा आ रही है\nना।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1857679,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अच्छा खासा टीवी सही जगह लगा हुआ था बट\nइसने जो करा है ठीक है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1865279,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो गेम इसने चालू कर दिया है कांट\nबिलीव यार गेम के अंदर गेम खेल रहा हूं GT",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1870399,
    "dDurationMs": 11441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सड्रास में भी खेला था फाइव में भी खेला\nथा बट ये तो प्रॉपर ही ऐसा लग रहा है अभी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1877520,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके न्यू गेम चालू करनी है\nदेखो यार इस गेम के अंदर मैं एक अजीब सी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1885279,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कॉज्ड प्ले प्लेस में आ चुका हूं। भाई\nयहां पर कोई रोशनी है तो सिर्फ इस लाइट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1890960,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हाउस की और चांद की। और यह जगह सच में\nबहुत ज्यादा अजीब सी है। भाई सच में ऐसी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1897120,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जगह पर कोई इंसान आ जाए तो क्या ही अजीब\nनहीं लगेगा यार। तो ये कुछ वैसा फील दे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1901679,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रही है गेम। भाई मेरे को पता है ये देख के\nकिसकी याद आ रही है? चूचू चार्ल्स गेम की।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1907919,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तुम्हें याद होगा तो वो भी कुछ ऐसी अंधेरे\nमें चांदनी ही रात में स्टार्ट होती है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1912799,
    "dDurationMs": 5773,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई।\nबोर हो गए [हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1920880,
    "dDurationMs": 8679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स आर्ट\nओके ओके फाइन यू कम बैक टू इट इफ यू वांट",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1926080,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इट ऑन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1932320,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई बोर हो गया था जेसन उस गेम से इसलिए\nगेम चेंज कर लिया है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1937840,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके प्ले स्ट्रीट ट्रेश स्ट्रीट ट्रैश\nक्या करना क्या है इसमें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1943200,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एनीवन",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1951279,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये थोड़ी सी रेजिडेंट इविल टाइप है गाइस।\nहमें इस गेम में ज़ॉम्बीज़ मारने हैं। अब",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1959600,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लगाई ना गेम बढ़िया-बढ़िया डाली तो ये चलाता\nनहीं है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1965360,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके।\nये हमारा कैरेक्टर है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1973360,
    "dDurationMs": 11319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ तेरी अब आ रहा है ना मजा लो गाइस ओ ओ\nसॉरी सॉरी देखा नहीं ओए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1981039,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ मैं तो मर रहा हूं",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1984720,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई इस जगह पे बहुत सारे ज़ॉम्बीज़ हैं और\nमेरे पास जिस लेवल का गन है ना मैं इन्हें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1991360,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मार नहीं पा रहा हूं। ओके तो मेरे को एक\nएबिलिटी मिली है। ऑटो शॉर्ट गन ले लेते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1995919,
    "dDurationMs": 6801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। ऑटोमेटिकली मारेगी।\nओके। एक और या तो मैं अपनी हेल्थ बढ़ा सकता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2000720,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। वेपन डैमेज बढ़ा सकता हूं या फिर\nस्टैमिना गेन कर सकता हूं। आई थिंक हमें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2005519,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वेपन डैमेज बढ़ाना चाहिए। नहीं हेल्थ\nबढ़ानी चाहिए थी। तो बेसिकली अपना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2010080,
    "dDurationMs": 6599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कांसेप्ट ये है कि मुझे ना गिय्स ढूंढने\nहैं। एक बारी हैवी मशीन गन लेते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2019440,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई मजा आ गया। भाई मुझे तो मजा आ रहा\nहै यार इस गेम को खेलने में यार। मुझे और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2023440,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "खेलने हैं। दिस।\nअबे [नाक से की जाने वाली आवाज़] यार अभी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2027120,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो मजा आना चालू हुआ था।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2033679,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वी गेट ऑफ\nमजा आ रहा था यार इसदर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2049040,
    "dDurationMs": 14440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फाइन\nआई टोल्ड आई वाफ आई स्टार्टिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2055520,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "शी वा कम मी सम मनी आई नो शीड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2068960,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो इनकी लड़ाई इसलिए हुई थी क्योंकि जब\nजसन ने ब्रा के लिए काम करना चालू करा था",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2074480,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो लशिया भी इसके साथ चलना चाहती थी और\nइसने मना कर दिया कि नहीं रिस्की जॉब है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2078960,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं आना चाहिए तुझे और इस बात पर वो\nगुस्सा हो गई और जसन को छोड़ के चली गई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2087839,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रोंग मी\nमतलब कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2091679,
    "dDurationMs": 8881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जसन केयर करता है लसिया की बट लसिया को वो\nचीज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2096079,
    "dDurationMs": 9825,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पसंद भी है बट उतनी पसंद नहीं।\nओके। अबे यार मेरे को खेलने दे यार।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2103884,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    } ]
  }, {
    "tStartMs": 2106880,
    "dDurationMs": 3239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या हुआ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2119440,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2127440,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्रिबक कोट वगैरह ढूंढ रहे हैं भाई। ओए\nकौन आ गया अच्छा पिज़्ज़ा है फुल खानापीना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2134000,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मस्ती चालू हो रखी है भाई दोनों की\nक्योंकि खुशी भी है भाई लसिया वापस आ रही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2138320,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है और उसको ये है कि भाई अभी जसन उसको कम\nप्रायोरिटी देगा और ये क्या कर रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2143839,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    }, {
      "utf8": "\nओए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2151699,
    "dDurationMs": 7341,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हांफने की आवाज़]"
    }, {
      "utf8": "\nकचरा मचा दिया भाई सो गया यहीं पे जग गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2156880,
    "dDurationMs": 11195,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबे क्या\nमैन नो कम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2162320,
    "dDurationMs": 11080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो बेड पे सोना चाहता है भाई ये क्या है\n[हंसी]",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2168800,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अच्छा खासा सोफे पे सो रहा था",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2175440,
    "dDurationMs": 5790,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिस फ्रीक्शन\n[चीखने की आवाज़]",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2204160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक्चुअली",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2217440,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके कम\nओके",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2221200,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सून\nलेट्स गो गाइस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2223680,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लसिया का फोन आ चुका है जिस कॉल का मुझे\nवेट था वो कॉल आ गया अपने पास और ल्यूसिया",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2230400,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कल ही जेल से फ्री होने वाली है और आई\nथिंक आज हमें उसके लिए कुछ चीजों की",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2236480,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्रिपरेशन कर लेनी चाहिए। देखो अभी सोफा\nटेबल तो कल हमने लगाए थे रात में और तुम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2240240,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देख ही सकते हो भाई किस हालत में ये सब है\nऔर ये तो अब ठीक करने नहीं वाला आराम से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2245359,
    "dDurationMs": 10041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई पसर के सो रहा है भाई ये खर्राटे देखो\nइसके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2250880,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसको उठाओ चल अपने घर जा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2257680,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सो रहा है भाई\nभाई ये बेड गंदा ना कर दे यार एक्चुअली",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2262000,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में\nआई एम किंग बॉय क्या है यह? ओ खैर छोड़ो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2268400,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार सोने दो। दोस्त ही है अपना बट बेड\nगंदा कर देगा। आज के दिन मुझे डर है भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2272880,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यह घर ना खराब कर दे अपना।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2277760,
    "dDurationMs": 4599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबे क्या मोटर लगी हुई है क्या?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2283440,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार अच्छा है लुसिया कल आ रही है। अगर आज\nवो सुबह आ रही होती ना तो तो दिक्कत हो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2288400,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाती भाई। वो नहीं रहती इस घर में। बट ठीक\nहै जो भी है। अभी एक बारी है ना चल के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2292720,
    "dDurationMs": 10960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अपने डॉलरस को थोड़ा सा खाना खिला देते\nहैं। ले भाई चूहा खा ये गया। ले भाई खत्म।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2302351,
    "dDurationMs": 8129,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    }, {
      "utf8": "\nखा गया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2306800,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो यार नहाना धोना तो हम लोग करते नहीं\nहै बट मुंह धो लेते हैं आज दोबारा से। कल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2313280,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहाए तो थे यार स्कuबा में। डेली नहाना\nजरूरी नहीं है। बाकी अपना जो लुक हुक है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2318960,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना मुझे ऐसा लगता है लसी आ रही है तो हमें\nथोड़ा हमें हेयर कट वगैरह बियर्डवियर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2322800,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थोड़ी सी ठीक करवा लेनी चाहिए। बाकी थोड़ा\nसा ना फ्रेश एंड अप हो जाते हैं। इससे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2326320,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फोकस बढ़ता है हमारा। और एक सेकंड मेरी\nपॉकेट में $3000 हैं। और आई थिंक मुझे अभी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2331520,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रखने भी चाहिए क्योंकि मैं जा रहा हूं\nलसिया के लिए थोड़ी बहुत शॉपिंग करने। और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2335760,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड नंगे थोड़ी जाएंगे यार कपड़े पहन\nलेते हैं। और मैं अपने लिए भी कुछ नए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2338960,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कपड़े खरीदूंगा यार क्योंकि हमेशा से वही\nकपड़े दोबारा मतलब ज्यादा अपने पास है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2343680,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं। तो बेटर है थोड़े ढंग के कपड़े खरीद\nके लाएंगे बाहर से। ये अच्छा लग रहा है ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2347599,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एकदम जेंटलमैन वाली आउटफिट है थोड़ी। ये\nभी अच्छी है और ये भी अच्छी है। ये पहनते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2352320,
    "dDurationMs": 7039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं आज। बाकी यहां एक बार ना चलके थोड़े\nबहुत अच्छे कपड़े भी खरीदेंगे। फिलहाल अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2356960,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पास बहुत सारा टास्क है जो कि हमें\nल्यूसिया के लिए करके रखना है उसके आने से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2361680,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पहले और उस काम के लिए अपने पास आज का\nपूरा का पूरा दिन है। तो लेट्स गो। जल्दी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2366800,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "से भाग के चलते हैं नीचे और फटाफट से चलते\nहैं थोड़ी बहुत शॉपिंग करने के लिए और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2372160,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अपनी गाड़ी में भी अपग्रेड्स करवा लूं\nक्या? देखो मेरे पास $3100",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2376960,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पॉकेट में है और $1 आई मीन $1500\nअ हमारे स्टैच में पड़े हुए हैं। हमारे घर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2384400,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के लॉकर में पड़े हैं। निकलने से पहले\nसारी चीजें चेक आउट कर लेते हैं क्या-क्या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2387760,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमें करना है। तो, यह है मार्केट वाला\nएरिया। तो, सबसे पहले हमें जाना है तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2392079,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सबसे पहले हम लोग जाने वाले हैं एक\nग्रोसरी स्टोर पे जहां पर हम लोग लसिया के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2396079,
    "dDurationMs": 7601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए कुछ चॉकलेट्स वगैरह और अच्छी-अच्छी\nचीजें खरीदेंगे। उसके बाद हम जाएंगे एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2401040,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फ्लावर शॉप पे बुके खरीदने के लिए। फिर\nउसके बाद हम लोग वेट एक रिंग भी खरीदने जा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2406400,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहे हैं। भाई एक्चुअली में हम ज्वेलरी\nस्टोर पे भी जा रहे हैं। उसके लिए एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2408720,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नेकलेस लेने के लिए और फिर जाएंगे थोड़ा\nबहुत अपने आप को ठीक-ठाक करने के लिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2413040,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हेयर कट वगैरह करा रहे हैं। भाई बहुत\nज्यादा काम है आज। तो लेट्स गो। बिना किसी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2417359,
    "dDurationMs": 10201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देरी के अपनी गाड़ी निकालते हैं और फटाफट\nसे चलते हैं ल्यूसिया को लेने। एक सेकंड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2423040,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड। किधर से? इधर से जाते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2429280,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो भाई आज मजा आने वाला है यार। क्योंकि\nयह एक्चुअल में एकदम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2437599,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बचा ली पता है एंड मोमेंट पे गाड़ी बचा ली\nऔर इसको देखो टक्कर मारे पड़ा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2444079,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है यार एक बारी गाड़ी भी थोड़ी सी ना\nफिक्स करवा लेंगे ज्यादा डेंटवेंट नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2447440,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "होना चाहिए अभी नहीं करवाएंगे वापसी में\nकरवा लेंगे अभी फिलहाल फ़ आ रहा है यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2451440,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रुको कटन का फ़ आ रहा है भाई बता भाई क्या\nहुआ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2461280,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके\nजस्ट लाइक",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2465440,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चेक\nडन है भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2479200,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके तो देखो यार अभी हमें कैंटेन का फोन\nआया था और कैंटेन हमें कह रहा है कि जैसा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2484480,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पिछला वाला हमने काम करा था ना इस टाइप के\nएक दो काम हमारे पास और आ चुके हैं और वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2490400,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "काम के लिए इसने मुझे लोकेशन दी है। इस\nबार शायद से यह नहीं आने वाला। इसने बोला",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2493680,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "था तुम अपनी बोट से जाओ। लोकेशन वगैरह यह\nदे देगा और वहां पर हमें ट्रेजर हंट करना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2498560,
    "dDurationMs": 6559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। जाके जो माल है वो ढूंढ के लाना है।\nतो ठीक है चलेंगे। लेकिन आज का दिन भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2503040,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं और कहीं नहीं लगाने वाला हूं। हम लोग\nभाई चुपचाप",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2506960,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लसिया अकेले सारी चीजें करेंगे। तो लेट्स\nगो। सबसे पहले हम लोग आ चुके हैं एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2511280,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ग्रोसरी स्टोर पे और जल्दी से चलते हैं\nभाई थोड़ी बहुत शॉपिंग करने के लिए। कितना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2517359,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अच्छा ग्रोसरी स्टोर है। थोड़ा बहुत पुराने\nस्टाइल का है बट काफी मस्त है। तो सबसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2522800,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पहले थोड़े एप्पल खरीद लेते हैं। ये हमने\nबैग लिया और उसके अंदर एप्पल डाल लिए। कुछ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2528560,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नाइस। देखो यार जसन को आई थिंक चीजें पता\nहै कि लुशिया को क्या-क्या पसंद है। तो वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2532880,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सारी एक-एक मैं तो कह रहा हूं भाई जितने\nभी स्वीट्स हैं, जितनी भी अच्छी-अच्छी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2536160,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चीजें हैं सब उठा लेते हैं। थोड़ी बहुत\nब्रेड रख लेते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2539839,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और यहां पर सामने यहां पर क्या-क्या है?\nओके। तो थोड़े से ये रख लेते हैं। देखो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2544640,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बेसिक-बेसिक सामान हमने अपने हिसाब से रख\nलिया है। बट कुछ-कुछ चीजें मैं अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2548400,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अकॉर्डिंग भी रख सकता हूं जो घर पे हमारे\nकाम आते रहेंगी। ठीक है? तो जितना सामान",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2552319,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमने लेना था ले लिया है। फटाफट से चल के\nबिलिंग करवा लेते हैं। फ़ आ रहा है भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2556079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रुको",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2560319,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कौन है भाई?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2571680,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ठीक है आ रहा हूं भाई\nठीक है ठीक है ठीक है ठीक है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2578160,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके\nतो लसिया की एक दोस्त है एंडडी उसके पास",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2582240,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई मीन लसिया के पास अभी कपड़े नहीं होंगे\nभाई वो इतने टाइम से जेल में है तो एंडडी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2586960,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और लसिया शायद फ्रेंड है और इन दोनों का\nबॉडी साइज सेम ही है तो अभी जाकर उससे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2591119,
    "dDurationMs": 9281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कपड़े उठाने हैं और\nइसने मुझे मुझे फोन पे लोकेशन भेजी है। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2597680,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लोकेशन एक सेकंड ये कहां खुल गया? तो ये\nहै एंडडी। इसकी लोकेशन सेट कर लेते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2603119,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी चल के पहले यही पिक कर लेंगे। तो गाइस\nवहां से तो मैं फटाफट निकल गया था",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2607280,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ग्रोसरीज लेकर। बट अभी-अभी मैंने नोटिस\nकरा कि अपनी गाड़ी का जो फ्यूल है वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2610960,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक्सट्रीमली लो है। भाई गाड़ी अचानक से\nबंद ना पड़ जाए। तो बेटर है भाई जल्दी से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2616079,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चल के पहले फ्यूल भरवा लेते हैं। और यहां\nपर आगे ऑलरेडी एक बंदे का फ्यूल भर रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2620560,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। क्या मैं दूसरा वाला ही नहीं यूज़ कर\nसकता हूं? एक सेकंड दूसरी साइड का नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2626800,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यूज़ कर पाएंगे क्या? मैं पता नहीं फ्यूल\nकैप तो इधर है। यह वाला यूज़ हो नहीं रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2631520,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। बट फॉर सम रीज़न शायद वो आउट ऑफ सर्विस\nहै यार। रुको इसके आगे वाले से हो जाएगा।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2637440,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं यहां से भी नहीं हो रहा है। लेफ्ट\nसाइड से करके देखता हूं। रुको भाई मैं ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2641040,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वाली ओए हो रहा हो रहा है। इतनी अच्छा पास\nखड़ी करनी पड़ती है। लेट्स गो।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2646400,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भरना चालू कर दिया फ्यूल। पूरा टैंक फुल\nकर देते हैं। पता नहीं कितने रुपए लगेंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2650000,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बट अभी पैसा पड़ा हुआ है तो डाल सकते हैं।\nडन गाइस। तो गाड़ी में फ्यूल भर दिया है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2655040,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और अब दोबारा से अपनी गाड़ी लेकर निकलते\nहैं। और आई थिंक एंडडी यहां से पास में ही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2659520,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। यस। तो ये रही। तो जो लोकेशन उसने\nभेजी थी वो मैंने मार्क कर ली है। और एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2664480,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बारी बस गाड़ी यहां से बाहर निकाल लूं।\nभाई हाईवे पे ना यूटर्न लेने में थोड़ा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2668880,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वेट करना पड़ता है। ऑलराइट गाइस लेट्स गो।\nतो यहां से अब बस मुझे लेफ्ट अंदर जाना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2672960,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। इधर ही कोई रेस्टोरेंट वगैरह है शायद\nवहां पर एंडडी हमारा वेट कर रही है। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2678319,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जल्दी से पहुंचते हैं और\nये जगह पर मैं पहले ऐसा लग रहा है आया हुआ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2684560,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। हां यहां तो मैं घूमने आया था भाई।\nये काफी ज्यादा प्यारा एरिया है। यहां पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2689760,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमने थोड़ी बहुत लड़ाईवड़ाई भी कर ली थी\nऔर इसी के साथ मैं पहुंच चुका हूं भाई उस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2694000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लोकेशन पे। ओके सामने एक लड़की तो बैठी\nहुई है। यही है क्या एंडडी? पता नहीं मुझे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2699520,
    "dDurationMs": 9559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चल के ना शायद पता करना पड़ेगा। एंडडी है\nकौन? एक बंदा खड़ा है भाई। तू तो तू जानता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2704640,
    "dDurationMs": 4439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है एंडडी को ऑर्डर एंडडी।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2710800,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "किधर?\nओ अच्छा यही है क्या?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2715760,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तू है क्या? एंडडी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2720560,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ यही है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2725920,
    "dDurationMs": 4919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो आई थिंक ये इस रेस्टोर में काम करती\nहै।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2735599,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चल तो जो कपड़े हैं वो इसकी गाड़ी में रखे\nहुए हैं। एक्साइटेड सीटली",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2743119,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अरे भाई कहां से झाड़ियों में से लेके जा\nरही है। दिस बिग",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2747359,
    "dDurationMs": 5601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो ये लुसिया की कोई बहुत ही ज्यादा अच्छी\nफ्रेंड है। यह भी बहुत एक्साइटेड है उससे",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2751040,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिलने के लिए। यह हमसे आज तक मिली नहीं\nथी। बट लुसिया के थ्रू ये जसन को जानती",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2754720,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थी। लुक\nओ उसने भी तारीफ कर दी कि भाई हमने कपड़े",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2760640,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बहुत अच्छे पहने हुए हैं। लशे को पसंद\nआएंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2766079,
    "dDurationMs": 10361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये बेस्ट फ्रेंड है उसकी।\nवैसे ठीक है। लुशिया अगर वापस आएगी तो वो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2772000,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भी इधर ही काम कर सकती है इसके साथ।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2783599,
    "dDurationMs": 5321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसकी गाड़ी में कितना सामान भरा हुआ है\nयार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2790720,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ला भाई\nथैंक यू सो मच",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2796960,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके\nचलो ठीक है ऑलराइट गाइस सो अभी हमें कपड़े",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2801359,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिल चुके हैं लसिया के लिए तो फटाफट से\nकपड़ों का बैग लेकर चलते हैं और इसको भी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2805680,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ट्रंक में रखते हैं मैंने ग्रोसरी रख दी\nऔर यह कपड़े भी ट्रंक में रखने चाहिए। ठीक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2812079,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है? तो इसको स्टोर कर देते हैं। लसियास\nक्लोथ परफेक्ट। और कर देते हैं इसको बंद।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2819200,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये गाड़ी अच्छी है। इसमें सामानवामान\nबहुत अच्छे से आ जाता है। एक बॉक्स में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2822720,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैंने लोड आउट रखा हुआ है। दूसरी तरफ अपना\nस्टोरेज भर के रखी हुई है। तो अच्छा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2826800,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई। बढ़िया है। बाकी अभी जैसा कि मैंने\nबताया था कि अभी हमें दो-तीन काम और है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2830960,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक अच्छा सा हेयर कट करवाना है और\nफ्लावर्स लेने हैं। फ्लावर वाले की शॉप",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2834640,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कहां पे है?\nठीक है। टेंशन वाली बात नहीं है। गाड़ी में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2838560,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फुल फ्यूल है। लोकेशनेशंस।\nसच में पागल है भाई ये। एक एक थप्पड़ तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2844560,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तेरे पड़े ना चाहिए। ए रुक जा एक सेकंड रुक\nजा। आ रहा हूं निकल। प्रॉब्लम तो अभी मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2849280,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तेरे को दिखाऊंगा क्या है मुझे। क्या हो\nगया?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2852800,
    "dDurationMs": 9519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई रुको जरा ऐसे।\nइसने मैं मोड़ रहा हूं। स्पीड डाउन कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2859440,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेता। एक सेकंड।\nरुक जा जरा। तो पिटेगा तो है। छोडूंगा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2865359,
    "dDurationMs": 7441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं इसको। देखो आज मेरा मूड ठीक था। मैं\nचाहता नहीं हूं खराब हो जाए किसी की भी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2868720,
    "dDurationMs": 10879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वजह से। रोक ले।\nरुक रुक रुक रुक। रोक ले।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2876960,
    "dDurationMs": 10040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चल देखो यार इसे उतना ही पीटेंगे कि पुलिस\nवाला मैटर ना हो जाए। हां भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2883040,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डंडा लेकर आया। क्या",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2887520,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डंडा कैसे दिखा रहा है?\nखत्म।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2892880,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बैड दे दे कम\nपैसे भी निकाल लिए भाई इसके $ बेसबॉल बैट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2901040,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेकर आया सीधा मुझे मारने के लिए इस गेम\nमें ना बेसिकली सारे लोग अच्छी गाड़ी नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2904880,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलाते कुछ एटीट्यूड वाले बंदे हैं कुछ\nफ्रस्ट्रेटेड है अपनी लाइफ से वो आपकी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2908960,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी इंटेंशनली ठोक देंगे अब अच्छी खासी\nगाड़ी थी अब फिर मेरे को एक बारी रिपेयर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2913839,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करवानी पड़ेगी यार चल के चलो ठीक है कोई\nदिक्कत वाली बात नहीं अभी गाड़ी लेकर चलते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2917440,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं सनसेट होने वाला है दिन खत्म हो जाए\nउससे पहले अपने काम खत्म कर लेते हैं वो ओ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2922400,
    "dDurationMs": 6959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सनसेट देखो गाइस क्या प्यारा लग रहा है।\nरोड पे जिस हिसाब से लाइट पड़ रही है ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2927520,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बहुत ही मस्त दिख रही है। फिलहाल अब जितनी\nभी शॉप है ना वो अपने टाउन के दूसरी साइड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2933119,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। बाय द वे मैंने शायद से अभी तक अपने\nटाउन का नाम बताया नहीं था। इस जगह का नाम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2936720,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है कील जहां पर हम लोग रहते हैं। और हम\nलोग पहुंच भी गए हैं फ्लावर वाली शॉप पे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2942960,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यहां से बस हमें अपनी गाड़ी को आगे से\nराइट मैं रूम भी डाल देता हूं यार। मैप",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2947599,
    "dDurationMs": 8681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में देखने के चक्कर में रुको एक बारी। तो\nयहां से जाएगी गाड़ी अपनी राइट। रुको।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2958640,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके। तो ये पतली वाली गली में आई थिंक\nपीछे है फ्लावर का शॉप। तो अगर हमें गलग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2962720,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुशिया को इंप्रेस करना है, बुके वगैरह\nदेख के खुश करना है तो हमें यहां पर आना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2967119,
    "dDurationMs": 6561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पड़ेगा। तो ये है शॉप। रुको गाड़ी साइड\nलगा देता हूं। भाई मैंने बताया था ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2971920,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी वाड़ी ठोक देते हैं। तो थोड़ी सी\nसाइड में पार्क करके रखता हूं ताकि रोड पे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2976400,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना रहे। कोई ठोक-पोक के ना जाए मेरी\nगाड़ी। और एक सेकंड ये बेसबॉल बैट बेसबॉल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2980319,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बैट रखो। इसको ना गाड़ी में रख देते हैं।\nगाड़ी में ज्यादा सही है। काम पड़ते रहता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2984480,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है भाई इन सब चीजों का जसन को। तो बेसबॉल\nबैट रखने की जगह नहीं है। गाड़ी को बंद",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2988960,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करके चलते हैं अंदर। बाद में ये सब कर\nलेंगे अभी फ्लावर्स खरीदते हैं चलके। और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2993040,
    "dDurationMs": 7039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई थिंक यहां पर ना हमें थोड़ा बहुत नॉलेज\nहोना चाहिए कि भाई कौन सा फ्लावर हमें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2997280,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेना चाहिए। बट अभी हमें इतना नहीं पता\nलसिया के बारे में।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3006559,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके ओके भाई ले रहे हैं भाई। तू बेच ले।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3018000,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टू द प्लेस फेस फेस\nतो देखो भाई प्राइस का डिफरेंस है। एक है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3024559,
    "dDurationMs": 10760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्मॉल बुक पांच का 10 का 25 का आई थिंक 25\nवाला लेना चाहिए भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3030160,
    "dDurationMs": 5159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो सबसे महंगा वाला हमने खरीद लिया। क्या",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3039520,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके\nतो हमने जो खरीदा है वो रेडी नहीं है। ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3044319,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमारे घर पे डिलीवर कर देगा। चलो सही है।\nये भी बढ़िया है। थैंक यू अंकल। अभी यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3049520,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या अच्छी-अच्छी जगह है यार। ये सब तो\nपता नहीं मैं कब एक्सप्लोर करूंगा। काम के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3054880,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए आ जाता हूं। वैसे मेरा घूमने का भी\nबहुत ज्यादा मन है। हर जगह। उधर नहीं गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3058880,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं अभी। तो देखो वहां पर भी कुछ लोग खड़े\nहो के नदी देख रहे हैं। तो यह सारा एरिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3063839,
    "dDurationMs": 6801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना बहुत ज्यादा अच्छा है। यह सब अभी ढंग\nसे एक्सप्लोर करा नहीं है यार बट करेंगे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3069040,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फिलहाल अभी दोबारा से गाड़ियों में बैठते\nहैं और हमारी अभी जो टू सीटर गाड़ी है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3074640,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फाइनली वो भी अब फुल होएगी क्योंकि अभी तक\nतो हम खाली अकेले ही घूमते रहते हैं। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3079040,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लास्ट एक दो चीजें अभी रह गई है जो कि\nहमारे लिए ऑप्शनल है। या तो हम चुपचाप घर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3083040,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वापस जा सकते हैं और फिर ल्यूसेस को ला\nसकते हैं या फिर उसको और इंप्रेस करना है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3086880,
    "dDurationMs": 6239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो हम उसे एक नेकलेस गिफ्ट कर सकते हैं।\nऔर मेरे को ऐसा लगता है हमारे पास पैसा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3090720,
    "dDurationMs": 7119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और हमें पता भी है कमाना कैसे है। तो आई\nथिंक एक नेकलेस तो गिफ्ट करना चाहिए। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3095359,
    "dDurationMs": 6801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो। थोड़ा सा आगे चलते हैं। तो यहां\nपर है एक ज्वेलरी स्टोर। तो गाड़ी पार्क",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3100720,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कर देते हैं यहां पर। और देखो जब गाड़ी\nऐसे हो ना तो पता है ऐसे पार्क करनी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3103599,
    "dDurationMs": 11201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चाहिए। ये घुमा के एकदम\nतो इस जगह का नाम है द साइरेंस चेस्ट। इस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3111680,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पे चलते हैं। डायमंड्स जेम स्टोन ओशियन\nइंस्पायर्ड कलेक्शन। भाई सामान तो सारा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3117280,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनके पास पड़ा हुआ है बट पता चला मेरे बजट\nमें नहीं आया तो प्रॉब्लम हो जाएगी। बहुत",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3122800,
    "dDurationMs": 6279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कुछ है यार। इससे ही बात करते हैं। नेकलेस\nचाहिए भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3136319,
    "dDurationMs": 4921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमने एक कस्टम नेकलेस का आर्डर दिया है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3145839,
    "dDurationMs": 8681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो हम लोग एक नेकलेस बनवा रहे हैं गोल्ड\nका जिसमास लिखा हो। जसन लुसिया के बच्चे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3151200,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "का नाम है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3161040,
    "dDurationMs": 9240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कैरेट की है तो ये पूछ रहे लॉक करना है या\nनहीं करना? आई थिंक कर लेना चाहिए। बट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3165760,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्राइस क्या है यार? 475",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3173680,
    "dDurationMs": 3439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमने ऑर्डर कर दिया है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3187280,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई सब लोग जानते हैं\nनाइस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3192960,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जैसे कि मैंने तुम्हें बताया था जो हमारा\nबॉस है ब्राइन भाई वो बहुत ज्यादा बड़ा ही",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3197359,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आदमी है। हमने इसे बताया हमारा जो एड्रेस\nहै ना वो एक ग्रीन कलर का हाउस है। बीच",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3201599,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "साइड पे देखा होगा। कह रहा है ये ब्राइन\nकी जगह मतलब आप जानते हैं भाई ब्राइन को।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3205839,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाकी ठीक है गाड़ी में तो मैं आकर बैठ\nचुका हूं। अब बस एक ही चीज रह गई है वो है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3210079,
    "dDurationMs": 10961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमारा हेयर कट। ओके अ इधर चलते हैं भाई।\nसेलोन सामने ही है। बढ़िया। ये पीछे कौन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3217839,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बैठा हुआ है नीचे। क्या हो गया भाई?\nमैन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3223839,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये ऐसे ही बैठे हुए हैं। मैं कौन पता नहीं\nकौन वहां नीचे बैठा हुआ है। रो रहा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3227280,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या कर रहा है। लेट्स गो गाइस। तो अभी हम\nलोग आ चुके हैं। हेलो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3232400,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाल कटवाने हैं भाई बढ़िया से देखते हैं\nभाई कैसा मेरे को तो यार देखो ऑनेस्टली",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3236960,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बताऊं करंट हेयर कट परफेक्ट है बट फिर भी\nट्राई करवा सकते हैं हेयर ग्रो हो जाएंगे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3242400,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाद ओ हो हो ये भी ये वाला एक सेकंड शुरू\nसे देखते हैं ये तो और ये गंदा है ये इस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3248960,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टाइम पे एक्चुअल में रोमन रेंस लग रहा है\nभाईडब्ल्यूई का",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3253680,
    "dDurationMs": 10159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो ये काफी सीरियस गैंगस्टर लुक है ये\nभी कुछ वैसे ही है ये काफी कूल है यह",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3260319,
    "dDurationMs": 8481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नॉर्मल है। यह भी अच्छा है। अरे करंट तो\nयार परफेक्ट ही है यार। चेंज करवा लेते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3266079,
    "dDurationMs": 7601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं थोड़े टाइम के लिए। यह अच्छा है। सबसे\nअच्छा ये है आई थिंक। तो ये करवा लेते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3271200,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। हेयर कलर\nब्लैक नहीं ये भी नहीं। आई थिंक हेयर कलर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3276079,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "jसन के करंट ब्लॉन्ड जा सकते हैं। बट इसके\nकरंट हेयर भी ब्लॉड ही है। और वो वाली शेड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3282400,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ज्यादा अच्छी है।\nबियर्ड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3287520,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्रॉपर क्लीन शेप कैसा लगा? ये देखो भाई\nमूछों वाला अंकल अपना करंट ही है वो वही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3293440,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सही है। ठीक है तो थोड़ी सी लुक चेंज हो\nगई है और सही लग रहा है अभी थोड़े से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3298960,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाल-वाल पता नहीं यार ज्यादा अच्छे नहीं\nलगेंगे ना तो दोबारा से आके चेंज करवा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3303920,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेंगे। तुम लोग बताना यार कमेंट्स में सही\nलग रहे हैं कि नहीं लग रहे। बाकी ठीक है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3308240,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सारे काम हो चुके हैं और अभी बस हमें घर\nपे जाके रेस्ट करना है और कल लुसिया को",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3313119,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेने के लिए जाना है। बट एक और इंपॉर्टेंट\nचीज है वो है भाई मेरी गाड़ी जो कि डैमेज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3318319,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो गई थी। तो अभी नहीं ठीक करवाएंगे इसको।\nजब लुसिया को लेने जाएंगे ना उससे पहले एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3322960,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बारी रिपेयर शॉप पे चले जाऊंगा। वो ज्यादा\nसही रहेगा क्योंकि यार पता है अभी ले",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3327839,
    "dDurationMs": 6561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाऊंगा वापस चलाऊंगा। कोई टेढ़ा-मेढ़ा\nबंदा मिल गया। गाड़ी ठोक-वोक दी। फिर वही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3332160,
    "dDurationMs": 6399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दोबारा रिपेयर जाओ यह करो तो बेटर है जब\nलसा को लेने जाएंगे ना तभी रिपेयर करवा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3336720,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेंगे क्योंकि हमें ना थोड़ा दूर जाना है।\nउसका जो प्रजन है वो अपने टाउन में नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3340880,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। वो की लंटो में नहीं है। वो दूसरे शहर\nमें हैमलेट जिसमें हम लोग पहले एक बारी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3345440,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी चुराने गए थे। तो वहां पे जाना है\nहमें। तो ऑलराइट गाइस फटाफट से भगाते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3350640,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी को और जल्दी से पहुंचते हैं अपने घर\nपे। लेट्स गो गाइस। सो हम लोग अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3355680,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नेबरहुड में एंटर हो चुके हैं। और जो मैं\nबोल रहा था ना यार गाड़ी में पॉप्स बहुत",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3359280,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कम आते हैं तो आते तो रहते हैं। ओए मेरे\nको लसे का मैसेज आया है। मैसेज आ गया यार।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3366319,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यानी वो इस टाइम पे फ्री हो गई है। मेरा\nघर कहां है? यहां से अंदर मैं थोड़ा भटक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3370799,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गया यार। रुको शायद सही जा रहा हूं। हां,\nयही तो है सामने। मैं इस टाइम पर एक्चुअली",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3374640,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में बिना मैप्स देखे आया हूं। अभी\nचलातेचलाते पहुंच गया बस। तो ठीक है। रात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3379359,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो ही गई थी। गाड़ी पार्क करते हैं। चलते\nहैं सोने के लिए जल्दी से। देखो यार जितनी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3385040,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चीजें थी घर में सब रिपेयर्ड है। साफ सफाई\nअपने घर में पूरी की पूरी है। बस मुझे चल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3388640,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के यह देखना है कि वो गंद मचा के ना गया\nहो क्योंकि कैल मुझे समझ आ चुका है भाई वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3393200,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जिमी भी है और वो लेस्टर भी है। मतलब\nगेमिंगवे में भी फुल घुसा हुआ है और थोड़ा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3398160,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सा हैकिंग वैकिंग में भी है। और ये सारी\nचीजों की उसे परवाह तो रहती नहीं। तो एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3402400,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बारी मैं लाइट ऑन कर लेता हूं। अरे\nखराब है क्या ये?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3408240,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दूसरी वाली लाइट चला। अंधेरा बहुत हो रखा\nहै यार घर में। हां ठीक है। घर तो थोड़ा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3413280,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "साफ ही है। एक बारी अंदर वाला रूम देख लो।\nबेडशीट वगैरह थोड़ी बहुत टेढ़ी-मेढ़ी कर रखी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3418480,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। पर सही है। कोई दिक्कत नहीं है। मुझे\nएक काम करना है। जितना भी सामान मैं लेकर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3421920,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आया हूं ना अभी ग्रोसरी स्टोर से सारी\nचीजें जो खरीद के लाया हूं आई थिंक वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3425920,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मुझे ऊपर लाकर रख लेनी चाहिए क्योंकि नीचे\nगाड़ी में पड़े-पड़े खराब हो जाएगी। वो फ्रिज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3430000,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में रहना चाहिए भाई। सारा सामान एप्पल\nवगैरह सब कुछ था। तो लेट्स गो। फटाफट से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3434559,
    "dDurationMs": 5681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलते हैं। सामान लेकर आते हैं नीचे अपनी\nगाड़ी से। पर ये गाड़ी का इंजन बंद कैसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3438559,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं हुआ है? तेरे को गाड़ी ना ढंग से\nपार्क कर देते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3443119,
    "dDurationMs": 9121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके। पता नहीं क्यों इंजन बंद नहीं हुआ था\nगाड़ी का।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3449119,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके। तो ये है अपनी स्टोरेज। तो ग्रोसरी\nबैग हमने यहां से ले लिया है। उससे कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3455200,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कपड़े भी ले लेते हैं और इसको बंद कर देते\nहैं। ठीक है? तो जितना भी सामान आज हम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3460400,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेकर आए थे, दोनों चीजें ले लिया। बाकी\nफ्लावर्स और नेकलेस थोड़े दिन में डिलीवर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3464640,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो जाएगा। और भाई सच में ल्यूसिया बहुत\nज्यादा खुश हो जाएगी देखकर नेकलेस को तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3469200,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हो शाम के टाइम पे भी अपने जो घर का\nएनवायरमेंट है ना डे में पूरा ही अलग रहता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3474000,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है शाम में पूरा एक पिंक एकदम सनसेट वाली\nवाइब फुल चेंज हो जाती है लेट्स गो तो ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3480640,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है सारा का सारा सामान जो हम लेकर आए हैं\nतो जल्दी-जल्दी सारा स्टोर कर देते हैं और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3485680,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फ्रिज में रख देते हैं जो चीजें फ्रिज में\nरहनी चाहिए तो जो रियलिज्म इस गेम में आया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3491599,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है ना भाई मजेदार है हमें एक-एक चीज का\nध्यान रखना पड़ता करता है अपने बिहेवियर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3495680,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "का, अपने नेचर का, अपनी हेल्थ का। बाकी\nपैसा अपने पास $2 है। मैं नहीं चाहता भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3502160,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "किसी भी प्रॉब्लम में फंसे, पुलिस-वलिस के\nचक्कर में जाए तो पैसा छीन लेती है पुलिस।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3506480,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो थोड़ा सा पैसा ना अपने स्टैश में रखवा\nदेते हैं। यहां पे सेफ रहेगा। डिपॉजिट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3512240,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करना है।\nसारे ही डाल देते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3520079,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो सारा का सारा पैसा मैंने अंदर रख\nदिया है। ऑलमोस्ट $4000 हैं अपने पास।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3525440,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाकी जो बचा हुआ पैसा था वो मैंने अपने\nपॉकेट में डाल दिया। $250 क्योंकि कल काम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3530079,
    "dDurationMs": 8641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आ सकता है। फिलहाल अभी जल्दी से चल के ना\nयार सो जाते हैं और कल टाइम से उठ के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3535359,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लसिया को लेने चलेंगे। लेट्स गो गाइस। गुड\nनाइट। सोने से पहले पता है एक बार फ़ोन चला",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3540720,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेता हूं आज क्योंकि ना कुछ इंपॉर्टेंट\nचीजें अच्छा आज मन नहीं है भाई जसन का",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3545040,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलाने का। डायरेक्ट सो गया भाई। लेट्स गो।\nगुड मॉर्निंग।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3552640,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अगला दिन हो चुका है और हम लोग सो कर उठ\nगए हैं। और मेरे को फ़ भी आ चुका है और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3558880,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "शायद से यह फ़ लसिया का ही है। उठा लेते\nहैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3566960,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बीन एनी मिनट।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3575280,
    "dDurationMs": 4559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सी यू सून\nपरफेक्ट है भाई तो लसे का फोन आ चुका है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3578640,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कुछ ही मिनट में उसकी जो बाकी\nप्रोसेसिंग्स है वो सब खत्म हो जाएगी और",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3581839,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फिर वो टोटली फ्री हो जाएगी प्रजनन से तो\nजल्दी से एक काम करते हैं भाई आज नहा लेते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3587119,
    "dDurationMs": 7761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं है ना हमेशा जरूरी नहीं है बट आज\nनहाना जरूरी है तो फटाफट से पहले नहाएंगे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3592400,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहा धो के बढ़िया ये जिम करने का भी मन था\nबट आज रहने देते हैं लेट्स गो अच्छे से हर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3597599,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तरफ भाई साबुनवाबुन लगा के हमने नहा लिया\nहै। बाकी ठीक है। बहुत है आज के लिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3605760,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार एक और चीज मैं ना भूल गया। मेरा प्लान\nतो था कि मैं कपड़े खरीदूंगा। बट मेरे पता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3610319,
    "dDurationMs": 5601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं माइंड से निकल गया कि कपड़े नए खरीद\nलेने चाहिए। लेकिन एक बार चेक कर लेता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3614400,
    "dDurationMs": 4959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। क्या पता वार्ड्रोब में कुछ तो पड़ा\nहो यार। हुडी पहन लूं क्या यार? हुडी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3617680,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्योंकि अभी सर्दियां नहीं है तो ट्राई\nनहीं करी थी। ये टीशर्ट डाल लेते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3621200,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थोड़ी सिंपल सी क्लीन सी है। नाइस।\nकॉम्बिनेशन तो मुझे सही लग रहा है कपड़ों",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3625280,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "का। तो ठीक है। अभी सिंपल ही है। बाकी की\nचेन पहन लेते हैं यार। थोड़ी इसको पहनते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3631920,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ही भाई चार चांद लग गए हैं लुक पे। देखो\nअपने पास वॉच काफी सस्ती सी है। बाद में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3636160,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "खरीदेंगे थोड़ी महंगी वाली। बट अभी फिलहाल\nके लिए यही पहनते हैं। अच्छी लग रही है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3639040,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्योंकि एक अपने पास चश्मा एक ही है यार।\nतो यही वाला लगा लेते हैं। कैप अपने पास",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3643359,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये बेसबॉल वाली पड़ी है। कैरी कर लेते\nहैं। अच्छी नहीं लगेगी तो बाद में उतार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3646559,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देंगे। और भाई पूरी लुक चेंज हो गई है\nयार। नाइस। यह आउटफिट काफी ज्यादा बढ़िया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3651359,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लग रही है। और मैं सही बताऊं तो कैप अच्छी\nनहीं लग रही। कैप ऑफ करते हैं। ग्लासेस ऑन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3656079,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करते हैं। नाइस। यह मस्त लुक हो चुकी है।\nतो बिना किसी देरी के चलते हैं भाई लसिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3663520,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "को लेने के लिए। और आज का वेदर सब कुछ\nएकदम बढ़िया हो रहा है। हमने उसके कपड़े",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3667920,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भी अपने साथ कैरी कर लिए हैं क्योंकि उसके\nपास इस टाइम पर प्रजन वाली आउटफिट होगी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3672480,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना। तो ले जाकर यह देंगे और फिर लेकर आते\nहैं भाई लसिया को। हां, यह तो वैसे मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3677119,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी में भी पड़े रहने दे सकता था। मैं\nलेकर क्यों आया हूं? चलो, यह रख देते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3680640,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अंदर ही।\nएंड एवरीथिंग इज परफेक्ट। गाड़ी में बैठते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3685839,
    "dDurationMs": 8561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं और मुझे पता करना पड़ेगा कि जाना किधर\nहै। मुझे एक्सैक्ट पता नहीं है। तो लसिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3691520,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जो है इस टाइम पर हैमलेट में है और हेमलेट\nमें ये है वो जगह जहां पर मुझे उसे लेने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3696160,
    "dDurationMs": 6399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के लिए जाना है। देखो यार अगर मुझे पता\nहोती ना कोई गाड़ी की शॉप तो एक बढ़िया सी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3700400,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कार भी रेंट करके चलते। बट अभी फिलहाल\nअपनी गाड़ी भी कोई बुरी नहीं है। बस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3704160,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रिपेयर करवा लेंगे इसे जाने से पहले ना एक\nबारी ज्यादा बेटर रहेगा वो। लेट्स गो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3708000,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाइस। देखो यार मुझे जाना उस तरफ है लेकिन\nकार मैकेनिक एकदम ऑोजिट साइड है। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3713040,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हेमलेट में ही चल के गाड़ी रिपेयर करवा\nलेंगे। यहां पर भी तो ये रहा एक बंदा। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3716720,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पहले यहां चल के गाड़ी रिपेयर करवाते हैं।\nफिर उसके बाद ल्यूसिया पे चलेंगे। लेट्स",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3720559,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गो। अभी टाइम वेस्ट नहीं करते हैं। गाड़ी\nको भगा लेते हैं और जल्दी से लेकर आते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3725200,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई लुशिया को। और मैं सच में बिलीव नहीं\nकर पा रहा हूं कि हां अब GTए में हम लोग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3730079,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक फीमेल प्रोटागनिस्ट से भी खेलने वाले\nहैं क्योंकि जसन के पास उसकी पार्टनर आ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3734480,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाएगी और हम लोग दोनों से एक स्टोरी लाइन\nके साथ खेलेंगे। मजा आएगा भाई। लेट्स गो।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3741920,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई पता है अपनी ना गाड़ी की ना स्पीड कम\nहै। बट जिस बंदे की शॉप पे हम लोग जाते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3746160,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं ना वो सिर्फ गाड़ी को रिपेयर नहीं\nकरता है। उसे अपग्रेड वगैरह सब कुछ करता",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3749760,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। पूरा का पूरा इंजन वो मोड कर सकता है।\nतो हमें ना बस बस तगड़ी मॉडिफिकेशन करवानी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3754480,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है यार। और भाई आज वेदर पता नहीं खतरनाक\nहो रहा है या फिर हमेशा सुबह के टाइम पे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3759680,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ऐसा ही वेदर रहता है। समझ नहीं आ रहा। ओ\nभाई सच में मैं गाड़ी बहुत ज्यादा स्पीड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3765680,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पे चला रहा हूं। बस एक्सीडेंट ना हो वरना\nतो कोई स्ट्रेस नहीं है। ऑन रहता है। यहां",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3770960,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "से मुझे एग्जिट लेना है ये वाला। यहां से\nफिर जाना है लेफ्ट। वैसे पता है पास में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3776240,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ही है ये वाला।\nवेट क्या बची है। मैं बहुत ज्यादा स्पीड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3781760,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में था। मुझे पता नहीं था भाई आगे लोग रेड\nलाइट पे होंगे। अचानक से ब्रेक दे दी वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3786000,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो सही है। वरना घुस जाता भाई मैं उन्हीं\nके अंदर ही गाड़ी लेकर अपनी। ऑलराइट गाइस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3790640,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो इसी के साथ हम लोग पहुंच चुके हैं पेंट\nशॉप पे जहां पर हम अपनी गाड़ी में एक नया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3795920,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पेंट प्लस रिपेयर करवा लेंगे। ऑलराइट गाइस\nतो हम लोग पहुंच चुके हैं अपनी गाड़ी लेकर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3799920,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पेंट शॉप पे। तो फटाफट से चल के गाड़ी को\nएक फ्रेश फ्रेश लुक तो क्या ही दे रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3805359,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रिपेयर कर।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3810799,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी को रिपेयर करने के लिए $290 चाहिए\nथे और मैं घर से लेकर निकला हूं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3817039,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सिर्फ और सिर्फ 250 जिसमें से $5 का टोल\nकट गया और 245 बचे। अब या तो यहां पर मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3823200,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चोरी चक्कारी कर लूं कोई या फिर ना एक काम\nऔर होता है जो कि थोड़ा सा रिस्की है। बट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3828559,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5 मिनट लगेंगे करके देखते हैं। मैं ना\nलोगों की गाड़ी से सामान चुरा सकता हूं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3833359,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो पहले मुझे किसी पार्किंग लॉट में जाना\nहोगा जो कि मुझे सामने ही दिख चुका है। चल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3837440,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के देखते हैं भाई किसी भी गाड़ी में सामान\nनिकलता है या नहीं। ये ये थोड़ा सा ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3840720,
    "dDurationMs": 8399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रिस्की काम है। ये तब करना होता है जब कोई\nना हो और ये टाइम बेस्ट है। सुबह का टाइम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3846240,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है तो सारे लोग ना सो रहे हैं। यहां पर\nज्यादा लोग हैं नहीं। तो ये यार ये ना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3851920,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एकदम सामने ही खड़ी है गाड़ी। उस पे चलते\nहैं। भाई यहां पर एक बंदा है यार।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3859440,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं भगा दूं क्या?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3863280,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यहां पे कुछ तो है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3867839,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं एक दरवाजे को तोड़ के अंदर जा सकता\nहूं। ओ ये जा रहा है जा रहा है। जा रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3871760,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जा रहा है जा रहा है। बढ़िया। इसको जाने\nदेते हैं भाई। ये जगह ना फिर अपने लिए सेफ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3876079,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। तोड़ के देखो दरवाजा।\nअरे अलार्म बच गया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3885680,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई मैंने गेट तोड़ा था उनका। अलार्म बज\nचुका है। वो तो ठीक है कि मैं यहां से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3890960,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चुपचाप निकल लेता हूं। पुलिस को कुछ पता\nनहीं चलने वाला। पुलिस बस इस एरिया में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3895520,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सर्च करने के लिए आने वाली है। मुझे यह\nएरिया खाली करना है क्योंकि अभी तक पुलिस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3900319,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "को मेरे ऊपर शक नहीं है। मैं इस एरिया में\nरहूंगा तो डाउट हो सकता है। तो बेटर है बस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3905359,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इस एरिया से निकल जाते हैं। दैट्स इट। और\nकुछ नहीं करना। भाई यार मुझे $50 चाहिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3910480,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं खराब गाड़ी लेकर नहीं जाने वाला हूं।\nकोई ऐसे पार्किंग लॉट पे चलते हैं जहां पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3915680,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लोग ना हो। तो ये जगह सही लग रही है मुझे।\nये जगह सही है। सही है। गाड़ी ना थोड़ी ऐसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3921039,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "खड़ी करते हैं ताकि किसी की नजर ना पड़े।\nभाई लेट्स गो। ये वाली गाड़ी चोरी करते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3924559,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। बस ना यार गाड़ी साउंड कर सकती है। उस\nचीज का ध्यान रखना है। गाड़ी से तब चोरी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3928319,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करो जब गाड़ी थोड़ी पुरानी हो। फिलहाल एक\nबार ट्राई करते हैं। तो मैंने यहां पर एक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3932640,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पेचकस लगा दिया है।\nऔर मैं इस टाइम पे चोरी करने का ट्राई कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3937280,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा हूं फुल।\nओके।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3941200,
    "dDurationMs": 7639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी बज चुकी है और गाड़ी के अंदर से\nक्या मिला है भाई?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3949680,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी में से सायरन बज रहा है भाई। पर मैं\nवहां से साइड हो गया हूं। यार पता है ये",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3953839,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना लक बेस्ड है। हमें गाड़ी से अच्छा\nसामान मिल भी सकता है, नहीं भी मिल सकता।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3958000,
    "dDurationMs": 5359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और जहां-जहां सायरन बजेगा वहां वहां\nऑटोमेटिकली पुलिस रिपोर्ट पहुंच जाती है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3961920,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और पुलिस यहां पर चेकिंग करने के लिए आ\nजाती है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3966960,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं नहीं था भाई। चेक करने आ गए ये लोग।\nपुलिस आ चुकी है यहां पर चेकिंग करने। भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3971839,
    "dDurationMs": 6321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिटरली पुलिस तुरंत आई है यार चलती हुई।\nव्हाट?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3976079,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं नहीं सॉरी सर मैं जा रहा हूं। वो देख\nरहा था मैं उसे खड़े हो के क्यों देख रहा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3979680,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हूं। देखो यार सिर्फ $50 की बात है और\nमुझे समझ नहीं आ रहा। मैं इतनी दूर अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3983839,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "घर वापस नहीं जाने वाला क्योंकि सारा पैसा\nवहां पड़ा हुआ है। बेस्ट तरीका यह है भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3988480,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चोरी-वोरी कर लो। छोटी मोटी चोरी कर लो।\nबस गाड़ी रिपेयर हो जाए। पर छोड़ो यार। उस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3993119,
    "dDurationMs": 6521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चक्कर में मैं खाली पीली ट्रबल में आ\nजाऊंगा। और वेट ये तो यह एरिया ग्रूव",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3996000,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्ट्रीट जैसा है यार।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4001359,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यहां पर भी एक चोरी मार लेते हैं। सामने\nना एक बढ़िया BMW खड़ी हुई है और यहां पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4006079,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कोई है भी नहीं। तो लगे हाथी इसके अंदर एक\nचोर ओ तो इसको भी चोरी करने के लिए सेम ही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4012960,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड। अरे तोड़ ही दिया हमने तो ये\nमारना नहीं है भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4019680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4022880,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक टोपी मिली है मुझे। वाह क्या यार मैं\nकिस चीज अच्छी लग रही है टोपी बट निकल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4028720,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेते हैं यहां से गाड़ियों से चोरी करना\nभाई बड़ा रैंडम है कुछ नहीं पता क्या मिल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4034319,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाए अभी दो गाड़ियां चोरी करी कुछ भी\nअच्छा नहीं मिला तो आई थिंक अभी और ट्राई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4038559,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं करना चाहिए निकल लेते हैं तो गाइस\nजैसा कि तुम लोग देख सकते हो राइट साइड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4043200,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "में प्रजनन है जहां पर हम लोग अपनी गाड़ी\nलेकर पहुंच चुके हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4047760,
    "dDurationMs": 6559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और ठीक है यार उतनी भी ज्यादा बुरी कंडीशन\nमें नहीं है अपनी गाड़ी बस एक टेल लाइट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4052240,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टूटी हुई है लेफ्ट वाली वही मुझे थोड़ी\nबहुत बुरी लग रही है। डोनी पता नहीं क्यों",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4057359,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैसेज कर रहा है। कुछ काम होगा। बाकी हां\nप्रजन बहुत ज्यादा बड़ा है। वहां तक मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4063680,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देख पा रहा हूं भाई इसकी वॉल एंड ही नहीं\nहो रही है। और राइट साइड में भी पूरा का",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4068160,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पूरा ये वाला जो एरिया है ना ये सारा का\nसारा प्रजन है। सारे वॉश टावर्स हैं। दैट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4071920,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मींस यहां से एस्केप करना भी ऑलमोस्ट\nइंपॉसिबल ही है। अभी मुझे जाना कहां पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4077119,
    "dDurationMs": 6321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है? इधर इनसे मिलने के लिए जाना है ना।\nशायद यहीं कहीं पर मेरे को मैं तो अंदर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4081760,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं जाऊंगा। तो शायद यहीं पर लुसिया बाहर\nआनी चाहिए। किससे बात करनी है? स्पीक टू द",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4086079,
    "dDurationMs": 6441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्रजन गार्ड। ये रहा।\nहेलो [हंसी] सर।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4092559,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या देख रहा है भाई?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4108239,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तुमने सुना उसने क्या बोला? भाई जसन का\nकोई पास्ट है जो यह सोच रहा है। रुको",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4114880,
    "dDurationMs": 4839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गार्ड कह रहा है मैंने तुम्हें शायद पहले\nदेखा हुआ है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4120799,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कॉल आ रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4127857,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[चीखने की आवाज़]"
    } ]
  }, {
    "tStartMs": 4141920,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ ये वो कॉल है जब लुसे पहली बार बताया था\nकि वो प्रजन में",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4153120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मीन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4165920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4169040,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यू बंचनी\nब्रोक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4172719,
    "dDurationMs": 12600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वीड नॉट ब्रेक वी गट फाइट एंड यू गो टू\nआल्सो नोन एस ब्रेकिंग अप इनफ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4180159,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुक इट वाचिंग हो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4187279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बेबीस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4196080,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लाइक\nजसन अभी तक मिला नहीं है क्या अपने बच्चे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4201120,
    "dDurationMs": 9323,
    "wWinId": 1,
    "segs": [ {
      "utf8": "से भाई\nआई शुड हैव टोल्ड यू आई मूव बाय द टाइम आई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4206960,
    "dDurationMs": 3483,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई थॉट आई हैंडल [संगीत]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4212960,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यस यू आर द डॉ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4224798,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    }, {
      "utf8": "\nथिंक दिस फकवर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4233040,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मोर अबाउट हाउ इज\nही इज गुड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4238320,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुकिंग [संगीत] आफ्टर हिम ही हैसवरीथिंग\nही नई जस्टदर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4246880,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गिव अ गुड लाइफ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4253199,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कम सीट\nयू ऑन द",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4258320,
    "dDurationMs": 10364,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ [संगीत]\nफाइनली आज का दिन और लसिया",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4263840,
    "dDurationMs": 6864,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्रजन से बाहर आ चुकी है फाइनली। हे\n[संगीत]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4271120,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई लेट्स गो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4277360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4282560,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक्सक्यूज मी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4289040,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नोगेट कम ऑन कम ऑन\nभाई ये दोनों बहुत ज्यादा इमोशनल हो गए इस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4294400,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टाइम पर\nऔर बहुत ज्यादा एक्साइटेड भी क्योंकि आज",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4297920,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "से इनकी एक नई लाइफ चालू होने वाली है और\nलसिया तो भाई बहुत ज्यादा एक्साइटेड है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4305520,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पीस कार\nफिनिक्स वाला",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4310719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "समथिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4313840,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिस इज वाइल्ड\nदिस इज इट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4317360,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इट्स\nयू ड्राइव कंप्लेनिंग आई लाइक इट।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4322800,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये दोनों अपनी आपस में गाड़ियों की बात कर\nरहे हैं और आई थिंक लसिया को अपनी गाड़ी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4327840,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उतनी पसंद नहीं आई बट ठीक है थोड़े टाइम\nमें आउटफिट की तारीफ हो चुकी है भाई सही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4333520,
    "dDurationMs": 11440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है देखो हमने बैठ के मेहनत करी डिजाइन करी\nतो लेट्स गो गाइस तो चलते हैं अभी लसे को",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4340080,
    "dDurationMs": 10400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेकर हमारे घर पे और\nशीशा टूट गया ना मेरा गाड़ी का",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4348000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या हालत कर रखी है यार मैंने दोनों साइड\nमिरर ही नहीं है तभी बेती हुई है भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4352480,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गाड़ी की\nओके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4358400,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लेट्स गो गाइस तो चलते हैं वापस से अपने\nघर पर और ये ट्रैफिक यार इधर बहुत ट्रैफिक",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4365840,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है तो भाई इन लोगों को एक दूसरे से बहुत\nसारी बातें करनी है क्योंकि इतने टाइम से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4370719,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक दूसरे से मिले नहीं है बहुत सारी चीजें\nहैं जो एक दूसरे के बारे में ये लोग अब",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4374800,
    "dDurationMs": 12200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं जानते जैसे कि जसन को आज पहली बार\nपता चला है कि उसका जो मतलब उसे अब जाकर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4381280,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कंफर्म्ड हुआ है कि हां उसका बच्चा है दबा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4395199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इनाइड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4406560,
    "dDurationMs": 6679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो इस टाइम पे जो\nभाई लसिया थोड़ा सा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4415199,
    "dDurationMs": 4191,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जॉब\n[संगीत]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4430320,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो यार इस टाइम पे लसिया जसन से ये पता\nकरना चाहती है कि यार वो उसे किस टाइप की",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4435600,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जॉब करनी चाहिए क्योंकि प्रजन से बाहर आई\nहै उसके पैर पे जो तुमने वो डिवाइस देखा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4440159,
    "dDurationMs": 6961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "था ना वो इसलिए लगा रखा ताकि उसे हमेशा\nमॉनिटर करा जा सके। उसे ट्रैक करा जा सके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4445440,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कि यह कहीं फिर से कोई क्राइम नहीं कर\nरही। अब पता नहीं वो किस टाइप का डिवाइस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4448640,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है। बट ऑब्वियसली इसमें कैमरा वगैरह नहीं\nहोगा। कुछ तो टेक्नोलॉजी होगी जिससे कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4453360,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लसिया ट्रैक्ड रहेगी। अगर वो क्राइम वाइम\nकरती है तो उसकी लोकेशन उनके पास रहेगी।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4458640,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये कहीं भी बच के भाग नहीं पाएगी। इसकी\nएग्जैक्ट लोकेशन हमेशा पुलिस वालों के पास",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4463760,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ही है। तो इसको हमें अपने साथ ज्यादा नहीं\nरखना चाहिए। पे जब भी हम क्राइम करते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4469199,
    "dDurationMs": 7601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो इसको भी प्रॉब्लम होगी और हम भी\nफसेंगे। फिलहाल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4473360,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हम लोग अभी पहुंच चुके हैं एक\nबार कह सकते हो। यहां पर थोड़ा सा चिल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4479040,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करने आए हैं। तो जल्दी से गाड़ी खड़ी करते\nहैं और चलते हैं भाई। तो इस जगह का नाम है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4485199,
    "dDurationMs": 6241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रेस्टी एंकर। देखने में तो भाई सच में\nबहुत ज्यादा ही रस्सी है। बट मुझे ऐसा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4489280,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लगता है ये इनकी थीम है। अंदर से ये अच्छी\nहोगी भाई जगह। और अभी जो इसने कपड़े पहने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4494800,
    "dDurationMs": 8439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हुए हैं वो शायद पता नहीं ऐसे रैंडम है।\nइसके हाथ में जो क्लोथ बैग है ना ये जाके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4498800,
    "dDurationMs": 4439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई थिंक चेंज करेगी या पता नहीं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4503360,
    "dDurationMs": 6280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके तो वो कपड़े ही चेंज करने जा रही है।\nलेट्स गो।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4509840,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये क्या चल रहा है?\nभाई ये जगह तो बहुत ज्यादा मस्त है। यहां",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4514400,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पर मैं ये आके खेल सकता हूं और पुलिस सॉरी\nसॉरी सॉरी सॉरी मैं जा रहा हूं। भाई यहां",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4518880,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पे पुलिस वाले आए हुए हैं और अपना मस्त\nगेम खेलने में लगे हुए हैं। स्नूकर चल रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4524400,
    "dDurationMs": 7597,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है भाई। आई थिंक हम लोग भी खेल सकते हैं\nबाद में जब तक यार चल के हम लोग कुछ ऑर्डर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4528719,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वगैरह कर देते हैं। और अबे\n[हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4532080,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये क्या कर रहा है यहां पे?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4546000,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये इसने भाई\nपार्टी प्लान कर रखी है।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4558960,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये बंदा प्राइवेसी नहीं देने वाला है\nजसन को कभी भी।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4567120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बेबी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4571679,
    "dDurationMs": 7761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नेक्स्ट टाइम\nबेबी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4576560,
    "dDurationMs": 10200,
    "wWinId": 1,
    "segs": [ {
      "utf8": " [हंसी]"
    }, {
      "utf8": " हाय हाय हाय हाय\nओ डोनी भी यहां पे है बेबी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4583520,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फॉर द",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4587760,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वी हैव बेबी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4602320,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये एटीट्यूड दिखा रहा है कि जसन को\nपैसा दिलाने वाला बंदा यही है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4609943,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4616640,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या मस्ती कर रहा है?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4620423,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[गला साफ़ करने की आवाज़]"
    } ]
  }, {
    "tStartMs": 4627280,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये डोनी पीट सकता है।\nतो इसको चाहिए पिंदे होप। ऑलाइट तो अभी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4633360,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बार टेंडर से मैंने दो ड्रिंक्स ले लिए और\nएक है लसिया के लिए और हमने तो भाई चॉकलेट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4638719,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चेक लिया। पता नहीं मैंने गलती से खरीद\nलिया है। हाय जसन किसने बोला?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4644800,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तूने बोला क्या?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4653280,
    "dDurationMs": 8399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये हमारी नेबर है।\nओ नाइस। मतलब ऐसा होता है कि जब तुम अपने",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4659760,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ही छोटे से टाउन में नियर बाय अलग-अलग\nएरिया में घूमो तो तुम्हें जान पहचान के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4663840,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बंदे मिलते रहते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4670960,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये लशिया ने किसी को मैसेज भेजा भाई।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4684000,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यस मैम\nन्यू बिगिनिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4689600,
    "dDurationMs": 6859,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मैं क्या लेकर आया हूं उसके हाथ में तो\nचेयर्स भी किस चीज का हुआ है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4694439,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    } ]
  }, {
    "tStartMs": 4707840,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जैसे कि मैंने बताया था ना बहुत बातें\nकरनी है दो सालों से एक दूसरे से मिले",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4712080,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं है\nअरे अरे भाई पानी में मत गिर जाना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4721760,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके ओके\nओ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4730320,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": " अबाउट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4735440,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ श",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4739920,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कैट कौन है\nबॉयफ्रेंड",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4743840,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ अच्छा इसकी फ्रेंड [संगीत]\nतो कैट इसकी कोई रिच फ्रेंड है जिसके बहुत",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4750320,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सारे कनेक्शन है\nऔर ये कह रही है कि अगर हम उनसे बात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4754159,
    "dDurationMs": 6601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करेंगे मिलेंगे तो वो हमें अच्छी जॉब\nदिलवा सकते हैं जहां से हमें बहुत पैसा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4757760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिलेगा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4768000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4772159,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जस्ट गुड फॉर देम भाई अभी बाहर आई नहीं\nहै।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4786560,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई\nतो जैसा कि तुमने सुना जो भी इसकी फ्रेंड",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4791199,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है प्रजन में थी। वो प्रजन से बाहर निकली।\nउसके बाद उसने एक नई यट खरीद ली एक ही",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4795199,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हफ्ते में क्योंकि उसके कनेक्शंस बहुत\nअच्छे हैं। तो यह भी कुछ वैसा ही प्लान कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4801205,
    "dDurationMs": 3994,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    }, {
      "utf8": " रहा है और ये सुसु करने आया जसन।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4806480,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": " वापस चलते हैं लसिया के पास।\n[कराहने की आवाज़]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4809600,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अरे\nसुसु नहीं हो रहा उसका चिल्लाए पड़ा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4817520,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो लसिया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4821120,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बट यार जगह बहुत ज्यादा प्यारी है ना। अभी\nअभी खाली है शायद रात में ये जगह पूरी भर",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4825760,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जाती होगी। बट डोनी ने थोड़ी सी बदतमीजी\nकरी आज हमारे साथ। इसको मैं बाद में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4830640,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पीटूंगा। अच्छा दोस्त मानता था वैसे। ये\nफिर भी अच्छा है। अच्छा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4840880,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये भी पक पक बहुत ज्यादा करता है।\nचलो भाई इसी के साथ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4853120,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फिर आगे ओ ब्राइन आया भाई।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4859040,
    "dDurationMs": 12159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ब्रायन की वाइफ है।\nलसिया राइट आई एम ब्र हेडर जस बॉस फ्रेंड",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4868159,
    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एंड लैंड\nजसियल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4874960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "शो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4879040,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ब्राइन यहां पर आया है तो शायद किसी\nकाम के लिए आया होगा या फिर पता नहीं जो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4883760,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भी है\nसब लोग अपना-अप बिजी हो चुके हैं भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4887920,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ब्राइन के साथ बिजी हो गया है लसिया\nब्रांड की वाइफ के साथ बिजी हो गई। तो मैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4896320,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्या करूं भाई? मैं वहां जाके क्या टीवी\nदेख लूं? सब इग्नोर मार रहे हैं यार। हम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4901600,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फुटबॉल सॉरी हम यहां पे बास्केटबॉल देख\nलेते हैं। भाई मैच चल रहा है बढ़िया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4910719,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4915760,
    "dDurationMs": 5479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "को कोई कॉल आ रहा था। कोई किसी से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4924800,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो उसे कोई तो कॉल आया और वो कॉल पे बात\nकरने जा रही है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4930639,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उसने बोला उसकी मॉम का फोन है। बट इससे\nपहले भी उसे एक मैसेज आया था और उसने पूरा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4936480,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हमसे छुप के बात करने की कोशिश करी थी।\nउसने फोन छुपा दिया था। तो एक बारी उसको",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4940719,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बात करने देते हैं। फिर चल के देखेंगे। बट\nऐसा हो सकता है कि वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4945679,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्ट्रेस इश्यूज वाला दिक्कत ना हो जाए\nभाई। हे मा या आई एम आउट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4950639,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके ग्ली\nअपनी मॉम से ही बात कर रही है वो ठीक है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4956480,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ट्रेस्ट इशूज़ हो गए थे भाई जस इनको चेक\nकरने आया था किसी और से तो नहीं बात कर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4960800,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रही बाकी वापस चलते हैं अंदर और जैसेजैसे\nतुम देख रहे हो भाई ये बार भरता ही जा रहा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4967520,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है यार भीड़ यहां पे बहुत ज्यादा आ चुकी\nहै ब्रायन बाहर जा रहा है ब्रायन से कुछ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4971920,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बात है क्या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4978800,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ब्राइन के साथ हमें बना के रखना है।\nसबसे बढ़िया बंदा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4983679,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के बारे में हम कंप्लेंट कर रहे हैं।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4997360,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इंट्रोड्यूस मसेल्फ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5001360,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो इसने बस डोनी को इसलिए रखा हुआ है\nक्योंकि वो प्लेन बहुत अच्छा उड़ाता है और",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5005040,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसका जितना भी माल है वो सारा का सारा\nडोनी ऊपर ऊपर से डिलीवर कर देता है भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5010639,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "प्लेन से ही तो कभी पकड़े ही नहीं जाते\nहैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5015760,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओवर देनी अंकल\nबॉस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5021360,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ\nअबाउट आई डू",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5025440,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सेलिब्रिटी शॉटर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5033199,
    "dDurationMs": 8601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई सेलिब्रिटी शॉट कुछ होता है क्या\nये सेलिब्रिटी शॉट मारने के लिए गया है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5045040,
    "dDurationMs": 10920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई देखते हैं ब्रायन अपना मजाक बनवाता है\nया अच्छा शॉट मारता है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5051440,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं मारा ओ गया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5059440,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई थोड़ा टाइम लिया पर अच्छा मारा।\nब्रांड तगड़ा बंदा है भाई।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5069103,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    } ]
  }, {
    "tStartMs": 5074480,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक बढ़िया शॉट मार के दिल जीता। उसके बाद\nअपने बारे में इंट्रोड्यूस कर दिया। भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5080000,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नाइस\nतो चलते हैं एक बाहर चलके लश से बात करते",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5084239,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। आई थिंक उसने अपनी मॉम से फ़ पे बात\nकर ली और वो य पर खड़ी हुई है सबसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5099120,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मनी शर्स",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5102880,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वी ग्रेशन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5108000,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई न",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5112400,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थैंक यू",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5118960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5133679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5138960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जस्टिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5143520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "या",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5158000,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये दोनों यहां पर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5163280,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "गेट ड्रिंक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5166880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबाउट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5171600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रेस्क्यू",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5178719,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ कैट आ गई। [चीखने की आवाज़]\nये है इसकी फ्रेंड।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5184639,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और मुझे ऐसा लगता है इसी की वजह से हम\nप्रॉब्लम में आने वाले हैं। सो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5196960,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई इसका बॉडीगार्डवर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5201840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5220560,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": " दिस प्लेस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5237920,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देव यू द एक्सपेंसिव लाइक योर लेवल्स एंड\nस्टफ यू नो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5244480,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यू वांट ड्रिंक\nतो ये वाली जो चिप इसके पैरों में लगाई है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5247760,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इससे ये इस टाउन को छोड़के नहीं जा सकती\nलुसिया",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5252480,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और ये जो इसके दोस्त आए हैं ये\nपता नहीं वाइस सिटी से आए हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5257440,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "और रिच है बहुत ज्यादा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5270080,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ भाई पार्टी चालू हो चुकी है भाई लेट्स\nगो",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5278880,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई ऑलरेडी लव दिस प्लेस\nकम ऑन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5283840,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ डांस करना चाहिए या नहीं? आई थिंक जाना\nचाहिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5288159,
    "dDurationMs": 6921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कम ऑन जेडी फॉर दिस\nमी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5296320,
    "dDurationMs": 6676,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बॉय लुकिंग गुड जे\n[चीखने की आवाज़]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5306000,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "से मिस यू डांस\nसो डांस वि मी ओ या ब्रिंग इट इन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5312800,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई यहां पे तगड़ी पार्टी चालू हो चुकी है।\nसारे लोग एकदम मस्त डांस करने में लगे हुए",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5317600,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। पहले थोड़ा माहौल शांत था बट जैसे ही\nये दोनों आए भाई पूरा पार्टी वाला माहौल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5323679,
    "dDurationMs": 7241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चालू हो चुका है। वैसे आई थिंक अभी भीड़ भी\nहो गया ना जब हम आए थे काफी खाली था डे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5327760,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "टाइम पे।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5331520,
    "dDurationMs": 6159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई जसन को आई थिंक ना उतना डांसवांस करना\nपसंद है नहीं तो वो काफी हल्का डांस कर",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5335920,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहा है। बट सही है। उसकी पर्सनालिटी पे\nमैच भी नहीं करेगा यार।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5339920,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उसको देखो ब्राइन को देखो क्या कर रहा है\nवो और ये दोनों क्या कर रहे हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5344560,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो क्या हुआ\nडांसिंग",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5348719,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डांसिंग\nबेबी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5354880,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुसिया लुसिया फील दिस\nही लाइक्स द म्यूजिक [हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5361199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5369679,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मी बीट मी अपू",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5374639,
    "dDurationMs": 9161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिस\nयस लेट हिम डांस डाउन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5379760,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके बेबी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5384320,
    "dDurationMs": 5399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दोबारा से डांस चालू हो चुका है इन दोनों\nके बीच",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5392719,
    "dDurationMs": 5881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई मीन व्हेन यू गॉट द राइट टू बी",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5400239,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अरे यार",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5405280,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये कह रही है कि जाके तुम मतिया से बात\nकरो वो जो लड़का है अगर उसके पास हमारे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5409760,
    "dDurationMs": 10280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए कोई कामवाम हो तो बट पता नहीं शायद\nजसन जाएगा नहीं और वेट [हंसी] एंडडी भी आ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5415280,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चुकी है यहां पे इसकी बेस्ट फ्रेंड",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5423462,
    "dDurationMs": 6177,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    }, {
      "utf8": "\nआई थिंक हे एंटी दिस इज जसन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5429840,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जसन\nटू सीडीक",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5442457,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    } ]
  }, {
    "tStartMs": 5447042,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    } ]
  }, {
    "tStartMs": 5458639,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देखो यार पार्टी तो बहुत जोरों शोरों से\nयहां पे चालू हो रखी है। मेरे को पता नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5464159,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्यों इतना मजा नहीं आ रहा है पार्टी करने\nमें। मेरे को हो रहा है भैया जल्दी खत्म",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5468400,
    "dDurationMs": 8799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करो बाहर लेके चलो। कोई मिशन-वशन पे भेजो\nयार। हो गया घूम लिए बहुत ज्यादा। बस करो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5473679,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार अभी। बट ठीक है। अभी लसिया साथ में है\nतो हमें यह सारी चीजें भी करनी पड़गी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5479600,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्योंकि इससे हम दोनों के जो बीच का\nरिलेशनशिप मीटर है वो बैलेंस रहेगा और वो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5484800,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बैलेंस रहना इस गेम के लिएेंट है ताकि\nहमारा जो कैरेक्टर जसन है वो मेंटली ठीक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5489760,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रहे। बाकी ठीक है। अभी सब कुछ एकदम चिल चल\nरहा है। तो ये तीनों यहां पर आकर बैठे हुए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5496320,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। भाई ये डेटिंग ऐप चला रहा है और उन\nदोनों को फ्लेक्स कर रहा है। [हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5501440,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई सही बताऊं तो अपने जितने भी दोस्त यार\nबने थे वो सारे के सारे यहां पर आए हुए",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5505440,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हैं। यहां पर अपने एक ये दोस्त है। उधर\nब्रायन बैठा हुआ है और और बाहर कौन है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5512000,
    "dDurationMs": 7199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई? बाहर मते ही है। अब यार देखो लुसिया\nने मुझे बोला था जाके मते से बात करो। कोई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5516560,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ना कोई बिजनेस का काम वो दे सकता है जो कि\nहमारे लिए इन फ्यूचर बहुत हेल्पफुल हो। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5521920,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलके उससे बात कर सकते हैं हम लोग।\nइससे अरे मैथ अरे रुक ना यार जा रहा है तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5529120,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कहां चला गया यार मैथ? अबे ब्रायन के साथ\nक्यों जाके बात कर रहा है यार?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5535040,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी मुझे इससे बात करनी चाहिए क्या? वो\nब्रायन के सामने बैठा है। पर मैं ब्रायन",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5540000,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "के लिए काम करता हूं। उसके सामने मैं इससे\nकोई काम की बात करूंगा तो सही नहीं है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5545440,
    "dDurationMs": 6199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार मैं थोड़ा सा लेट हो गया। इंटरप्ट\nकरते हैं इन्हें।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5561280,
    "dDurationMs": 10480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलो तो यह इसको ले जा चुकी है और अभी हम\nलोग यहां पर बैठकर इससे बात कर सकते हैं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5568400,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये इटालियन है और इसमें पैसा वैसा बहुत\nसही है",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5578080,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डीजे [संगीत]\nडीजेस्ट लुकिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5588000,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्टफ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5593600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अबाउट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5598080,
    "dDurationMs": 6280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वी\n[हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5601360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जस्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5604960,
    "dDurationMs": 6199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी हमने इसको बोल दिया कि यार हमें काम\nकरना",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5608159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5612159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "देकिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5618480,
    "dDurationMs": 5239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मी गड शीट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5636239,
    "dDurationMs": 3721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इटालियन बात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5657280,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "उसने मना कर दिया कि वो हमारी कोई हेल्प\nनहीं कर सकता। इसका जो बॉस है वो बहुत",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5661280,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ज्यादा सक्सेसफुल आदमी है और बहुत ज्यादा\nप्राइवेट पर्सन है। तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5667600,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसके पास हमारे लिए कोई काम नहीं है। बट\nठीक है देखते हैं क्या पता अभी बात-वात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5671679,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करेंगे तो कुछ बने। अभी हम लोग इसके साथ\nखेलने जा रहे हैं। बेसिकली बात ऐसी है कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5675920,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसके साथ बनाने में बातचीत बनाने में बहुत\nफायदा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5680320,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मी\nओके जसन वर्सेस",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5685040,
    "dDurationMs": 7119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मतया का मैच होने वाला है।\nभाई देखते हैं कौन जीतता है। मजा आएगा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5690320,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "यार। रियल में तो देखो मैं थोड़ा ठीक-ठाक\nसा खेलता हूं। बट लेट्स गो। ऐम करते हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5695920,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके स्ट्रेट ही मारना है मुझे। और ये है\nरोटेशन और ये है प्रेशर।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5702320,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ नाइस\nकम्स मी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5705600,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बढ़िया शॉट मारा एक और यह दोनों आ चुकी है\nमैच देखने के लिए और देखते हैं भाई मुझे",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5711920,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो ये बहुत ज्यादा प्रोफेशनल लग रहा है\nस्ट्राइक पॉकेट करी है उसने यानी अपनी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5715920,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सॉलिड से भाई ये तो फुल फोकस में अरे तेरी\nअच्छा नहीं इतना भी अच्छा नहीं है दूसरा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5721440,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "शॉट इसका सही नहीं गया\nनेक्स्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5725360,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तो हमें सॉलिड्स पे शूट करना है और सॉलिड\nदेखो मुझे ग्रीन वाली एक बनती हुई दिख रही",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5731440,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "है और भाई ये जो बंदे यहां पर आए हुए हैं\nना ये बहुत ज्यादा ही बदतमीजी कर रहे हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5737199,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मतलब अभी मतिया से आके पंगे लेने लग गए\nहैं। पहले लसिया से ले रहे थे। कोई बात",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5742719,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नहीं कुछ पंगे तो लेके देखो भाई। हम यहां\nपर हमारा बॉस है। अपने दो चार बंदे हैं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5747199,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पीटने पे आ गए तो पीटेंगे तो इन्हें\nये वाली तो जानी चाहिए।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5757199,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक सेकंड",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5760639,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मामी\nहे मारियो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5764400,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "स्टेप ऑफ द टेबलस",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5770616,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    } ]
  }, {
    "tStartMs": 5777199,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई ये पिटेगा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5780560,
    "dDurationMs": 6679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आजा बाहर आजा भाई बाहर आजा हो गई भाई हो\nगई ओ मतिया तू भी आवेग",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5790800,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बट ठीक है। हां यार इनको निकल जाना चाहिए\nफालतू के मैटर से। भाई ये बहुत देर से",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5794719,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पंगे ले रहे थे। मारने पीटने का मन तो\nमेरा पूरा है।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5801600,
    "dDurationMs": 12360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आजा आजा आजा आजा ये तो मुझे चल चल।\nचल [हंसी] क्या पीट रहा है भाई जसन।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5810960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चल",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5815360,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ये मारेगा। ये मारेगा।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5819520,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बचा है कोई\nअच्छा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5826080,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक-एक करके जब तक आएंगे पिटते ही रहेंगे\nभाई जसन बहुत ज्यादा पावरफुल है भाई आजा",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5832080,
    "dDurationMs": 12159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अच्छा पीछे से पीछे से ओए उसको देखो\nलुसिया को देखो पागल है क्या [हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5840000,
    "dDurationMs": 11119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अरे लुसिया क्यों मार पुलिस आ गई भाई और\nलुसिया को पे तो वैसे भी ओके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5849199,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलो लुसिया को हमने भगा दिया है। हम भी\nभाग गए हैं साथ में। लेट्स गो। बस हम",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5853760,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "सायरेंस से दूर भाग रहे हैं। भाई\nकम ऑन कीप",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5858960,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डेंजरस लड़की है भाई ये।\nहम उधर आगे मार रहे हैं। इसने पीछे उसको",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5864480,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पीटना चालू कर दिया। मतलब लुसे जसन डरते\nतो नहीं है भाई किसी से।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5869600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5873520,
    "dDurationMs": 7119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चलो चलो चलो चलो चलो भागो भागो भागो बस\nअभी पुलिस से बचना है किसी भी हालत में तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5877760,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पतली पतली गलियों से छुपते हुए निकलना है\nबट उन्हें पता नहीं है ना कि लुसिया है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5882400,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसलिए वो ट्रैक नहीं कर रहे होंगे अगर\nउन्हें पता चल गया लुसिया तो ट्रैक करके",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5885760,
    "dDurationMs": 12680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ढूंढ सकते हैं\nलेट्स गो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5891040,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भागते उगते आ चुके हैं बीच साइड पे ओ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5899040,
    "dDurationMs": 7818,
    "wWinId": 1,
    "segs": [ {
      "utf8": "अभी बेसिकली ऐसी लाइफ हो चुकी है जसन की\nकि उसे अपना तो ध्यान रखना ही साथ के साथ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5903679,
    "dDurationMs": 6509,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लुसिया को भी प्रोटेक्ट करके रखना।\n[हंसी]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5908168,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[अचानक ज़ोर से सांस लेने की आवाज़]"
    } ]
  }, {
    "tStartMs": 5913407,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[हंसी]"
    } ]
  }, {
    "tStartMs": 5921199,
    "dDurationMs": 3641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "फिर से भागो।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5927920,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भागते-भागते घर आ चुके हैं। और\nलुक दे।",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5934159,
    "dDurationMs": 5641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "चेंज\nनाइस दे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5940400,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "हाउस टू चल रहा है अभी\nपेंट भीम ने नया वाला कर दिया था सीडी ठीक",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5945679,
    "dDurationMs": 7401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कर दी है\nलेट सी लसिया का रिएक्शन कैसा आता है घर",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5950080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पेली",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5958400,
    "dDurationMs": 6098,
    "wWinId": 1,
    "segs": [ {
      "utf8": "समथिंग\nनो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5962239,
    "dDurationMs": 10361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वी\n[हंसी] उसमें करंट आता है। इफ आई द स्विच",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5969600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "थिंग्स",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5972719,
    "dDurationMs": 6201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डोंट इट\nश",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5979600,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओ फ्लावर्स आए होंगे ना",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5986719,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इन दिक [संगीत]\nये कुछ और है यार ये अच्छा क्रिब है ये तो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5991360,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "क्रेब मंगवाया था वो है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5996960,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बाथरूम क्लोज [संगीत]\nआर प्रीटी लोस्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6001834,
    "dDurationMs": 7405,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[नाक से की जाने वाली आवाज़]"
    }, {
      "utf8": "\nदिस प्लेस जस्ट",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6005679,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वो है वो फ्लावर्स",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6012000,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नम\nगुड मॉर्निंग गाइस नेक्स्ट डे हो चुका है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6017360,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जसन सोके उठ चुका है और शायद से हमारे घर\nमें नीचे कोई आया है कौन बजाया",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6022880,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ओके\nतो लसी तुम लोग सोच रहे होंगे भाई कहां जा",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6027440,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "रही है? तो ल्यूसिया को भी एक अच्छी लाइफ\nस्टार्ट करनी है। तो लसिया जा रही है अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6031760,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए कोई जॉब ढूंढने। अब पता नहीं ये क्या\nकाम ढूंढेगी। बट हां अब यह कोई क्राइम",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6035840,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "व्राइम इन फालतू चीजों में नहीं पड़ने\nवाली। वो एक नॉर्मल लाइफ जीने वाली है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6039920,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "जिसके लिए वो निकल चुकी है। और हमारा भी\nफोन बच गया। अपने पास भी बहुत काम पेंडिंग",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6044480,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "पड़े हैं। हम लोग दो दिन से इन्हीं सब में\nलगे हुए थे। ट्रेजर हंटर वाले जो भैया थे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6048239,
    "dDurationMs": 6681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "कैंटीन उन्होंने भी एक नई लोकेशन भेजी है।\nडोनी का भी फोन आ गया।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6055760,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लास्ट\nये बहुत बदतमीजी कर रहा है",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6058480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "भाई",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6074880,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "नेविगेशन\nहो",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6090239,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "डोनी की तो देखो फील्डिंग सेट होगी। ये\nइसने हमें एक काम दिया है और उस काम पे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6096880,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "इसने हमें बोला है कि मतलब ये जानता है ना\nहमें प्लेन उड़ाना आता है। इसीलिए यह हमें",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6102080,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "एक ऐसी जगह भेज रहा है जहां पर ना कुछ तो\nपैकेज वैकेज है जिसका मतलब अच्छी खासी",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6107440,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "वैल्यूुएबल है वो। तो कह रहा है वहां से\nसामान उठा के लाओ पर ब्राइन को मत बताना",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6111760,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मुझे देना। मतलब ये बीच में से भाई मालवाल\nअब गायब कर रहा है। ब्रांड के धंधे में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6116719,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "दिक्कत दे रहा है। अब अपने ऊपर है। हमें\nइसके साथ रह के आगे बढ़ना है या ब्रायन।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6121119,
    "dDurationMs": 6481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आई थिंक ब्राइन ज्यादा बेटर रहेगा। ये पता\nनहीं भाई एक तो इसको बात करनी आती नहीं।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6125280,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "बदतमीजी करता है पूरे टाइम। तो इसकी तो हम\nफील्डिंग सेट करेंगे। फिलहाल जैसा कि",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6130159,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "तुमने देखा लूसिया वापस आ चुकी है और वो\nभाई आके सोई और तुरंत चली भी गई है अपने",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6134880,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए कोई काम ढूंढने। बट हमारे तो वही\nपुराने बिज़नेस चलते रहेंगे। ट्रेजर एंड के",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6139679,
    "dDurationMs": 6081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "लिए जाना है। डोनी ने एक नया काम दे दिया\nहै और लुसिया का भी ध्यान रखना है। फिलहाल",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6143760,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "आज के इस वाले एपिसोड को यहीं पर एंड करते\nहैं। आई होप आपको इस गेम प्ले वीडियो में",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6147840,
    "dDurationMs": 6399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मजा आया होगा। वीडियो अच्छी लगी तो जाके\nवीडियो को लाइक करो। कमेंट्स में बताओ भाई",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6152000,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिशनंस देखने में मजा आ रहा है कि नहीं।\nबाकी चैनल को अगर अभी तक सब्सक्राइब नहीं",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6156239,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "करा है। क्या कर रहे हो यार? जल्दी से जाओ\nसब्सक्राइब का बटन दबा दो। बाकी मैं तुमसे",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6160000,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "मिलूंगा नेक्स्ट वीडियो में। तब तक के लिए\nगुड बाय।",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6164276,
    "dDurationMs": 4484,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]",
      "isSpeakerChange": 1
    }, {
      "utf8": "\nया",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6170825,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    } ]
  }, {
    "tStartMs": 6175411,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]",
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6181961,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[संगीत]"
    } ]
  } ]
}
