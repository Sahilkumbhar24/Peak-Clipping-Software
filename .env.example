# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PeakCut settings (all optional; defaults work out of the box)
PEAKCUT_DATA="./data"
PEAKCUT_ACCOUNTS="0"
PEAKCUT_AI_PROVIDER=""
PEAKCUT_AI_MODELS=""
PEAKCUT_AI_KEY=""
PEAKCUT_AI_BASE_URL=""
PEAKCUT_PUBLIC_URL=""
PEAKCUT_MAX_UPLOAD_MB="500"
PEAKCUT_MAX_ACTIVE_JOBS_PER_USER="5"
PEAKCUT_MAX_CREATORS="50"
PEAKCUT_CONTACT_EMAIL=""
PEAKCUT_LEGAL_NAME="PeakCut"
PEAKCUT_LEGAL_COUNTRY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PEAKCUT_IG_APP_ID=""
PEAKCUT_IG_APP_SECRET=""
PEAKCUT_TIKTOK_CLIENT_KEY=""
PEAKCUT_TIKTOK_CLIENT_SECRET=""
YTDLP_PROXY=""
YTDLP_COOKIES_FILE=""

